					<shape type="name_only"/>
				</aux>
				<aux color="#FF2600" font_color="#FF2600" x="11.1645" y="310.296" width="200.5" height="32" name="Emissions Control Rate">
					<shape type="name_only"/>
				</aux>
				<aux x="86.7457" y="199.582" width="214.5" height="32" name="Industrial CO2 Emissions">
					<shape type="name_only"/>
				</aux>
				<aux x="406.921" y="104.613" width="271.5" height="32" name="Atmospheric CO2 Concentration">
					<shape type="name_only"/>
				</aux>
