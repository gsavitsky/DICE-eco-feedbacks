				<aux color="#008F00" font_color="#008F00" x="683.146" y="362.98" name="solar constant"/>
				<aux color="#008F00" font_color="#008F00" x="782.833" y="299.5" name="surface albedo (A)"/>
				<aux color="#008F00" font_color="#008F00" label_side="top" x="559.619" y="54.955" width="20.1429" height="20.1429" name="Specific Heat Capacity (c)"/>
				<aux color="#008F00" font_color="#008F00" x="579.476" y="285.64" name="incoming radiation"/>
				<stock color="#009051" font_color="#009051" x="464.575" y="68.902" name="surface temperature (Ts)"/>
				<aux color="#008F00" font_color="#008F00" x="689.333" y="177.409" name="Earth's Surface Area (aE)"/>
				<aux color="#008F00" font_color="#008F00" x="769.583" y="55.955" name="Stefan-Boltzman Constant (sigma)"/>
				<aux color="#008F00" font_color="#008F00" label_side="top" x="266.833" y="226.123" name="methane opacity (t(CH4))"/>
				<aux color="#008F00" font_color="#008F00" label_side="top" x="166.722" y="90.5" name="water vapor saturation\nconstant (P0)"/>
				<aux color="#008F00" font_color="#008F00" x="248.833" y="18.056" name="relative humidity (H)"/>
				<aux color="#008F00" font_color="#008F00" x="129.333" y="173.784" name="molar gas constant (R)"/>
				<aux color="#008F00" font_color="#008F00" x="302.136" y="169.784" name="water opacity (t(H2O))"/>
				<aux color="#008F00" font_color="#008F00" label_side="top" x="436.651" y="177.409" name="vertical opacity of the\ngreenhouse atmosphere (t)"/>
				<connector uid="1" angle="16.0062">
					<from>&quot;methane_opacity_(t(CH4))&quot;</from>
					<to>&quot;vertical_opacity_of_the_greenhouse_atmosphere_(t)&quot;</to>
				</connector>
				<connector uid="2" angle="356.756">
					<from>&quot;water_opacity_(t(H2O))&quot;</from>
					<to>&quot;vertical_opacity_of_the_greenhouse_atmosphere_(t)&quot;</to>
				</connector>
				<aux color="#008F00" font_color="#008F00" x="224.386" y="122.061" name="relative humidity (pH2O)"/>
				<connector uid="3" angle="320.25">
					<from>&quot;water_vapor_saturation_constant_(P0)&quot;</from>
					<to>&quot;relative_humidity_(pH2O)&quot;</to>
				</connector>
				<connector uid="4" angle="256.772">
					<from>&quot;relative_humidity_(H)&quot;</from>
					<to>&quot;relative_humidity_(pH2O)&quot;</to>
				</connector>
				<connector uid="5" angle="328.703">
					<from>&quot;exponential_function_(e)&quot;</from>
					<to>&quot;relative_humidity_(pH2O)&quot;</to>
				</connector>
				<connector uid="6" angle="316.24">
					<from>&quot;molar_gas_constant_(R)&quot;</from>
					<to>&quot;relative_humidity_(pH2O)&quot;</to>
				</connector>
				<connector uid="7" angle="328.458">
					<from>&quot;relative_humidity_(pH2O)&quot;</from>
					<to>&quot;water_opacity_(t(H2O))&quot;</to>
				</connector>
				<aux color="#008F00" font_color="#008F00" x="400.075" y="45.955" name="initial Ts"/>
				<aux color="#008F00" font_color="#008F00" x="135.712" y="108.5" name="exponential function (e)"/>
				<aux color="#008F00" font_color="#008F00" label_side="top" x="277.333" y="122.061" name="fall and plant\ndeath - turnover (L)"/>
				<connector uid="8" angle="174.351">
					<from>&quot;fall_and_plant_death_-_turnover_(L)&quot;</from>
					<to>&quot;relative_humidity_(pH2O)&quot;</to>
				</connector>
				<aux color="#008F00" font_color="#008F00" label_side="top" x="295.333" y="267.64" name="carbon dioxide opacity (t(CO2))"/>
				<connector uid="9" angle="32.5589">
					<from>&quot;carbon_dioxide_opacity_(t(CO2))&quot;</from>
					<to>&quot;vertical_opacity_of_the_greenhouse_atmosphere_(t)&quot;</to>
				</connector>
				<aux color="#008F00" font_color="#008F00" x="332.047" y="27.955" name="Anomaly"/>
				<connector uid="10" angle="141.27">
					<from>&quot;surface_temperature_(Ts)&quot;</from>
					<to>Anomaly</to>
				</connector>
				<connector uid="11" angle="152.076">
					<from>initial_Ts</from>
					<to>Anomaly</to>
				</connector>
				<aux color="#008F00" font_color="#008F00" x="355.006" y="332.542" name="partial pressure of CO2 (pCO2)"/>
				<connector uid="12" angle="176.102">
					<from>&quot;surface_albedo_(A)&quot;</from>
					<to>incoming_radiation</to>
				</connector>
				<connector uid="13" angle="322.845">
					<from>&quot;vertical_opacity_of_the_greenhouse_atmosphere_(t)&quot;</from>
					<to>incoming_radiation</to>
				</connector>
				<connector uid="14" angle="143.277">
					<from>solar_constant</from>
					<to>incoming_radiation</to>
				</connector>
				<aux color="#008F00" font_color="#008F00" x="914.653" y="20.955" name="outgoing radiation"/>
				<connector uid="15" angle="13.5641">
					<from>&quot;Stefan-Boltzman_Constant_(sigma)&quot;</from>
					<to>outgoing_radiation</to>
				</connector>
				<aux color="#008F00" background="white" font_color="#008F00" x="926.69" y="195.409" name="energy balance"/>
				<connector uid="16" angle="273.947">
					<from>outgoing_radiation</from>
					<to>energy_balance</to>
				</connector>
				<connector uid="17" angle="14.5678">
					<from>incoming_radiation</from>
					<to>energy_balance</to>
				</connector>
				<aux color="#008F00" font_color="#008F00" x="800.833" y="183.409" name="global energy balance"/>
				<connector uid="18" angle="141.229">
					<from>energy_balance</from>
					<to>global_energy_balance</to>
				</connector>
				<connector uid="19" angle="356.92">
					<from>&quot;Earth&apos;s_Surface_Area_(aE)&quot;</from>
					<to>global_energy_balance</to>
				</connector>
				<flow color="#008F00" font_color="#008F00" x="593.619" y="131.357" name="global temperature change">
					<pts>
						<pt x="743.476" y="131.357"/>
						<pt x="467.762" y="131.357"/>
						<pt x="467.762" y="86.402"/>
					</pts>
				</flow>
				<connector uid="20" angle="353.21">
					<from>&quot;surface_temperature_(Ts)&quot;</from>
					<to>global_temperature_change</to>
				</connector>
				<connector uid="21" angle="289.837">
					<from>&quot;Specific_Heat_Capacity_(c)&quot;</from>
					<to>global_temperature_change</to>
				</connector>
				<connector uid="22" angle="203.196">
					<from>&quot;Stefan-Boltzman_Constant_(sigma)&quot;</from>
					<to>global_temperature_change</to>
				</connector>
				<connector uid="23" angle="154.306">
					<from>&quot;Earth&apos;s_Surface_Area_(aE)&quot;</from>
					<to>global_temperature_change</to>
				</connector>
				<connector uid="24" angle="84.7624">
					<from>incoming_radiation</from>
					<to>global_temperature_change</to>
				</connector>
				<connector uid="25" angle="112.408">
					<from>&quot;partial_pressure_of_CO2_(pCO2)&quot;</from>
					<to>&quot;carbon_dioxide_opacity_(t(CO2))&quot;</to>
				</connector>
				<connector uid="26" angle="173.719">
					<from>&quot;surface_temperature_(Ts)&quot;</from>
					<to>&quot;relative_humidity_(pH2O)&quot;</to>
				</connector>
				<connector uid="27" angle="21.483">
					<from>&quot;surface_temperature_(Ts)&quot;</from>
					<to>outgoing_radiation</to>
				</connector>
				<aux color="#008F00" font_color="#008F00" x="482.762" y="303.64" name="mole volume of the atmosphere (ka)"/>
				<connector uid="28" angle="192.747">
					<from>&quot;mole_volume_of_the_atmosphere_(ka)&quot;</from>
					<to>&quot;partial_pressure_of_CO2_(pCO2)&quot;</to>
				</connector>
				<aux color="#008F00" font_color="#008F00" x="469.651" y="239.5" name="pre-industrial\nmoles of molecules in\nthe atmosphere (fgtm)"/>
				<connector uid="29" angle="187.888">
					<from>&quot;pre-industrial_moles_of_molecules_in_the_atmosphere_(fgtm)&quot;</from>
					<to>&quot;partial_pressure_of_CO2_(pCO2)&quot;</to>
				</connector>
				<stock x="392.404" y="440.167" name="Atmospheric Carbon"/>
				<connector uid="30" angle="89.9018">
					<from>Atmospheric_Carbon</from>
					<to>&quot;partial_pressure_of_CO2_(pCO2)&quot;</to>
				</connector>
				<module x="146.241" y="480.167" name="Carbon"/>
				<connector uid="31" angle="240.265" isee:autocreated="true">
					<from>&quot;partial_pressure_of_CO2_(pCO2)&quot;</from>
					<to>Carbon</to>
				</connector>
				<connector uid="32" angle="272.663" isee:autocreated="true">
					<from>Anomaly</from>
					<to>Carbon</to>
				</connector>
				<connector uid="33" angle="257.259" isee:autocreated="true">
					<from>&quot;surface_temperature_(Ts)&quot;</from>
					<to>Carbon</to>
				</connector>
			</view>
		</views>
	</model>
	<model name="Carbon">
		<variables>
			<stock name="Atmospheric Carbon">
				<eqn>Ca0</eqn>
				<inflow>Plant_Respiration</inflow>
				<inflow>Soil_Respiration</inflow>
				<inflow>&quot;Air-Sea_Exchange_(LL)&quot;</inflow>
				<inflow>&quot;Air-Sea_Exchange_(HL)&quot;</inflow>
				<outflow>Photosynthesis</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<stock name="Vegetation Carbon">
				<eqn>Cv0</eqn>
				<inflow>Photosynthesis</inflow>
				<outflow>Plant_Respiration</outflow>
				<outflow>Turnover</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<stock name="Soil Carbon">
				<eqn>Cs0</eqn>
				<inflow>Turnover</inflow>
				<outflow>Soil_Respiration</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<flow name="Photosynthesis">
				<eqn> (&quot;photosynthesis_rate_(kp)&quot;*&quot;Cv(s)&quot;*&quot;photosynthesis_normalizing_constant_(kMM)&quot;)*

((pCO2_ppmv-&quot;compensation_point_(kc)&quot;)/(&quot;Half_saturation_point_(KM)&quot;+(pCO2_ppmv-&quot;compensation_point_(kc)&quot;)))*

((15+Anomaly)^2)*(25-Anomaly)/5625</eqn>
				<non_negative/>
				<units>pgC/Year</units>
			</flow>
			<flow name="Plant Respiration">
				<eqn>&quot;plant_respiration_rate_(kr)&quot; * Vegetation_Carbon * &quot;plant_respiration_normalizing_constant_(kA)&quot; * EXP(-&quot;Plant_respiration_activation_energy_(Ea)&quot; / (R * &quot;surface_temperature_(Ts)&quot;))</eqn>
				<non_negative/>
				<units>pgC/Year</units>
			</flow>
			<flow name="Turnover">
				<eqn>&quot;turnover_rate_(kt)&quot;*Vegetation_Carbon</eqn>
				<non_negative/>
				<units>pgC/Year</units>
			</flow>
			<flow name="Soil Respiration">
				<eqn>&quot;soil_respiration_rate_(ksr)&quot;*Soil_Carbon*&quot;soil_respiration_normalizing_constant_(kB)&quot;* 2.7^(-1*(308.56/(&quot;surface_temperature_(Ts)&quot; -227.13)))</eqn>
				<non_negative/>
				<units>pgC/Year</units>
			</flow>
			<stock name="Low Latitude Ocean Carbon">
				<eqn>Col0</eqn>
				<inflow>&quot;intermediate-warm_exchange&quot;</inflow>
				<outflow>&quot;Air-Sea_Exchange_(LL)&quot;</outflow>
				<outflow>&quot;Warm-intermediate_Ocean_exchange&quot;</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<stock name="High Latitude Surface Ocean Carbon">
				<eqn>Coh0</eqn>
				<outflow>&quot;Air-Sea_Exchange_(HL)&quot;</outflow>
				<outflow>&quot;cold-intermediate_ocean_exchange&quot;</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<stock name="Intermediate Ocean Carbon">
				<eqn>Coi0</eqn>
				<inflow>&quot;Warm-intermediate_Ocean_exchange&quot;</inflow>
				<inflow>&quot;cold-intermediate_ocean_exchange&quot;</inflow>
				<inflow>&quot;deep-intermediate_exchange&quot;</inflow>
				<outflow>&quot;Intermediate-deep_Ocean_exchange&quot;</outflow>
				<outflow>&quot;intermediate-warm_exchange&quot;</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<stock name="Deep Ocean Carbon">
				<eqn>Cod0</eqn>
				<inflow>&quot;Intermediate-deep_Ocean_exchange&quot;</inflow>
				<outflow>&quot;deep-intermediate_exchange&quot;</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<flow name="Air-Sea Exchange (LL)">
				<eqn>-Faw</eqn>
				<units>pgC/Year</units>
			</flow>
			<flow name="Air-Sea Exchange (HL)">
				<eqn>-Fac</eqn>
				<units>pgC/Year</units>
			</flow>
			<aux name="photosynthesis rate (kp)">
				<eqn>0.184</eqn>
				<units>1/year</units>
			</aux>
			<aux name="plant respiration rate (kr)">
				<eqn>0.092</eqn>
				<units>1/year</units>
			</aux>
			<aux name="turnover rate (kt)">
				<eqn>0.092</eqn>
				<units>1/year</units>
			</aux>
			<aux name="soil respiration rate (ksr)">
				<eqn>0.0337</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Half saturation point (KM)">
				<eqn>120</eqn>
				<units>ppmv</units>
			</aux>
			<aux name="Plant respiration activation energy (Ea)">
				<eqn>54830</eqn>
				<units>J/mol</units>
			</aux>
			<aux name="photosynthesis normalizing constant (kMM)">
				<eqn>1.478</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="plant respiration\nnormalizing constant (kA)">
				<eqn>8.7039e9</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="thermohaline overturning (kT)">
				<eqn>6.5e7</eqn>
				<units>m^3/s</units>
			</aux>
			<aux name="high latitude overturning (kU)">
				<eqn>4.87e7</eqn>
				<units>m^3/s</units>
			</aux>
			<aux name="warm-intermediate exchange (kwi)">
				<eqn>1.25e7</eqn>
				<units>m^3/s</units>
			</aux>
			<aux name="intermediate-deep exchange (kid)">
				<eqn>2e8</eqn>
				<units>m^3/s</units>
			</aux>
			<aux name="piston velocity (ks)">
				<eqn>1752</eqn>
				<units>m/year</units>
			</aux>
			<aux name="compensation point (kc)">
				<eqn>29</eqn>
				<units>ppmv</units>
			</aux>
			<aux name="soil respiration normalizing constant (kB)">
				<eqn>157.072</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="partial pressure of CO2 (pCO2)" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>ppm</units>
			</aux>
			<aux name="Anomaly" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>K</units>
			</aux>
			<aux name="Cs0">
				<eqn>1500</eqn>
			</aux>
			<aux name="Ca0">
				<eqn>596</eqn>
			</aux>
			<aux name="Cv0">
				<eqn>550</eqn>
				<units>pgC</units>
			</aux>
			<aux name="kD">
				<eqn>0.27</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="Cv(s)">
				<eqn>Cv0-(cumulative_deforestation*kD)</eqn>
			</aux>
			<stock name="cumulative deforestation">
				<eqn>0</eqn>
				<inflow>&quot;Deforestation_(D)&quot;</inflow>
				<non_negative/>
				<units>PgC</units>
			</stock>
			<flow name="Deforestation (D)">
				<eqn>LUC</eqn>
				<non_negative/>
				<units>PgC/Year</units>
			</flow>
			<aux name="LUC">
				<eqn>0</eqn>
				<units>pgC</units>
			</aux>
			<group name="Land Use Change" run="false">
				<entity name='"Cv(s)"'/>
				<entity name='"Deforestation_(D)"'/>
				<entity name="cumulative_deforestation"/>
				<entity name="kD"/>
				<entity name="LUC"/>
			</group>
			<aux name="R">
				<eqn>8.314</eqn>
				<units>J/mol*K</units>
			</aux>
			<group name="Initialization" run="false">
				<entity name="Ca0"/>
				<entity name="Cod0"/>
				<entity name="Coh0"/>
				<entity name="Coi0"/>
				<entity name="Col0"/>
				<entity name="Cs0"/>
				<entity name="Cv0"/>
			</group>
			<aux name="Th">
				<eqn>275.15</eqn>
				<units>K</units>
			</aux>
			<aux name="Tl">
				<eqn>295.15</eqn>
				<units>K</units>
			</aux>
			<aux name="Faw">
				<eqn>&quot;piston_velocity_(ks)&quot;*aO*Al*bw*(&quot;partial_pressure_of_CO2_(pCO2)&quot;-&quot;pCO2(w)&quot;)*12e-15*rho</eqn>
			</aux>
			<aux name="Al">
				<eqn>0.85</eqn>
			</aux>
			<aux name="Ah">
				<eqn>0.15</eqn>
			</aux>
			<aux name="pCO2(w)">
				<eqn>&quot;pCO2(w)0&quot; * (Low_Latitude_Ocean_Carbon / Col0)^&quot;beta_(revelle_factor)&quot;</eqn>
			</aux>
			<aux name="pCO2(c)">
				<eqn>&quot;pCO2(c)0&quot; * (High_Latitude_Surface_Ocean_Carbon / Coh0)^&quot;beta_(revelle_factor)&quot;</eqn>
			</aux>
			<aux name="bw">
				<eqn>EXP(-60.2409 + 93.4517*(100/Tl) + 23.3585*LN(Tl/100) 
         + 34.7*(0.023517 - 0.023656*(Tl/100) + 0.0047036*(Tl/100)^2))</eqn>
				<units>mol/kg atm</units>
			</aux>
			<aux name="aO">
				<eqn>3.6e14</eqn>
				<units>m^2</units>
			</aux>
			<aux name="Fac">
				<eqn>&quot;piston_velocity_(ks)&quot;*aO*Ah*bc*(&quot;partial_pressure_of_CO2_(pCO2)&quot;-&quot;pCO2(c)&quot;)*12e-15*rho</eqn>
			</aux>
			<aux name="bc">
				<eqn>EXP(-60.2409 + 93.4517*(100/Th) + 23.3585*LN(Th/100) 
         + 34.7*(0.023517 - 0.023656*(Th/100) + 0.0047036*(Th/100)^2))</eqn>
				<units>mol/kg atm</units>
			</aux>
			<flow name="Warm-intermediate Ocean exchange">
				<eqn>&quot;warm-intermediate_exchange_(kwi)&quot; * (Low_Latitude_Ocean_Carbon / Vl) * 3.15576e7 *12e-15</eqn>
				<non_negative/>
				<units>pgC/Year</units>
			</flow>
			<flow name="Intermediate-deep Ocean exchange">
				<eqn>&quot;intermediate-deep_exchange_(kid)&quot; * (Intermediate_Ocean_Carbon / Vi) * 3.15576e7 * 12e-15</eqn>
				<non_negative/>
				<units>pgC/Year</units>
			</flow>
			<aux name="beta (revelle factor)">
				<eqn>11</eqn>
			</aux>
			<aux name="pCO2(w)0">
				<eqn>286e-6</eqn>
			</aux>
			<aux name="pCO2(c)0">
				<eqn>270e-6</eqn>
			</aux>
			<aux name="Col0">
				<eqn>730</eqn>
				<units>pgC</units>
			</aux>
			<aux name="Coh0">
				<eqn>140</eqn>
				<units>pgC</units>
			</aux>
			<aux name="rho">
				<eqn>1027</eqn>
				<units>kg/m^2</units>
			</aux>
			<aux name="Coi0">
				<eqn>10040</eqn>
			</aux>
			<aux name="Cod0">
				<eqn>23860</eqn>
				<units>pgC</units>
			</aux>
			<flow name="cold-intermediate ocean exchange">
				<eqn>&quot;high_latitude_overturning_(kU)&quot; * (High_Latitude_Surface_Ocean_Carbon / Vh) * 3.15576e7 *12e-15</eqn>
				<non_negative/>
				<units>pgC/Year</units>
			</flow>
			<aux name="Vl">
				<eqn>3.06e16</eqn>
				<units>m^3</units>
			</aux>
			<aux name="Vh">
				<eqn>5.4e15</eqn>
				<units>m^3</units>
			</aux>
			<aux name="Vi">
				<eqn>3.6e17</eqn>
				<units>m^3</units>
			</aux>
			<aux name="Vd">
				<eqn>9.7e17</eqn>
				<units>m^3</units>
			</aux>
			<flow name="deep-intermediate exchange">
				<eqn>&quot;intermediate-deep_exchange_(kid)&quot; * (Deep_Ocean_Carbon / Vd) * 3.15576e7 * 12e-15</eqn>
				<non_negative/>
				<units>pgC/Year</units>
			</flow>
			<flow name="intermediate-warm exchange">
				<eqn>(&quot;thermohaline_overturning_(kT)&quot; + &quot;warm-intermediate_exchange_(kwi)&quot;) * (Intermediate_Ocean_Carbon / Vi) * 3.15576e7 * 12e-15</eqn>
				<non_negative/>
				<units>pgC/Year</units>
			</flow>
			<stock name="surface temperature (Ts)" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>K</units>
			</stock>
			<aux name="pCO2 ppmv">
				<eqn>&quot;partial_pressure_of_CO2_(pCO2)&quot;*1e6</eqn>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
				<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
				<isee:loop_indicator color="black" background="white" vertical_text_align="top" font_size="12pt"/>
				<numeric_display color="white" background="white" font_size="12pt" border_width="thin" border_style="solid" isee:transparent="false" isee:show_divider="true" isee:show_bounding_box="true" label_side="left"/>
				<graph color="black" background="white" font_size="12pt" axis_color="#666666" grid_color="#C8C8C8" isee:graph_area_color="white" legend_position="bottom" isee:transparent="false" isee:hide_border="false" axis_title_font_style="normal" axis_title_font_weight="normal" axis_title_text_decoration="none" axis_title_text_align="center" axis_title_vertical_text_align="center" axis_title_font_color="black" axis_title_font_family="Arial" axis_title_font_size="12pt" axis_title_text_padding="2" axis_title_text_border_color="black" axis_title_text_border_width="thin" axis_title_text_border_style="none" axis_label_font_style="normal" axis_label_font_weight="normal" axis_label_text_decoration="none" axis_label_text_align="center" axis_label_vertical_text_align="center" axis_label_font_color="black" axis_label_font_family="Arial" axis_label_font_size="9pt" axis_label_text_padding="2" axis_label_text_border_color="black" axis_label_text_border_width="thin" axis_label_text_border_style="none">
					<isee:series_styles>
						<isee:series_style color="blue" thickness="1"/>
						<isee:series_style color="red" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="fuchsia" thickness="1" pen_style="dotted"/>
						<isee:series_style color="#008F44" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#FF7F00" thickness="1"/>
						<isee:series_style color="#7F00FF" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="#0CA0FF" thickness="1" pen_style="dotted"/>
						<isee:series_style color="lime" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#FF007F" thickness="1"/>
						<isee:series_style color="aqua" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="#F586FF" thickness="1" pen_style="dotted"/>
						<isee:series_style color="black" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#C8C8C8" thickness="1"/>
