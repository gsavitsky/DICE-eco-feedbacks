<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee" uses_submodels=""/>
		<name>Full Lenton</name>
		<uuid>d41a60a2-183b-4701-abe4-6622abd782a5</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="4.0" isee:build_number="3710" isee:saved_by_v1="true" lang="en">Stella Professional</product>
	</header>
	<ai_information>
		<status verified="false"/>
	</ai_information>
	<sim_specs isee:sim_duration="1.5" isee:run_prefix="Run" isee:simulation_delay="0.0015" isee:restore_on_start="false" method="Euler" time_units="Year" isee:instantaneous_flows="false" isee:ignore_module_errors="false" isee:strict_units="true" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000">
		<start>0</start>
		<stop>1000</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<isee:prefs saved_runs="5" keep="false" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" isee:design="Deluxe Prev-Next Blue Green Pastel" isee:design_custom="false" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<isee:number_format_extenders/>
	<default_format/>
	<model_units>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
			<alias>fraction</alias>
		</unit>
		<unit name="Meters">
			<eqn/>
			<alias>m</alias>
			<alias>meter</alias>
		</unit>
		<unit name="Moles">
			<eqn/>
			<alias>mol</alias>
			<alias>mole</alias>
		</unit>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
		<unit name="Joules">
			<eqn/>
			<alias>j</alias>
			<alias>joule</alias>
		</unit>
		<unit name="Watts">
			<eqn/>
			<alias>w</alias>
			<alias>watt</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<aux name="solar constant">
				<eqn>1368</eqn>
				<units>W m^-2</units>
			</aux>
			<aux name="surface albedo (A)">
				<eqn>0.225</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Specific Heat Capacity (c)">
				<eqn>4.69e23</eqn>
				<units>J K^-1</units>
			</aux>
			<aux name="incoming radiation">
				<eqn>(((1-&quot;surface_albedo_(A)&quot;)*solar_constant)/4) * (1+(3/4*&quot;vertical_opacity_of_the_greenhouse_atmosphere_(t)&quot;))</eqn>
				<units>W m^-2</units>
			</aux>
			<stock name="surface temperature (Ts)">
				<eqn>initial_Ts</eqn>
				<inflow>global_temperature_change</inflow>
				<non_negative/>
				<units>K</units>
			</stock>
			<aux name="Earth's Surface Area (aE)">
				<eqn>5.101E14</eqn>
				<units>m ^2</units>
			</aux>
			<aux name="Stefan-Boltzman Constant (sigma)">
				<eqn>5.67e-8</eqn>
				<units>W m^-2 K^-4</units>
			</aux>
			<aux name="methane opacity (t(CH4))">
				<eqn>0.0231</eqn>
				<units>unitless</units>
			</aux>
			<aux name="water vapor saturation\nconstant (P0)">
				<eqn>1.4e11</eqn>
				<units>Pa</units>
			</aux>
			<aux name="relative humidity (H)">
				<eqn>0.6177</eqn>
				<units>unitless</units>
			</aux>
			<aux name="exponential function (e)">
				<eqn>2.71828</eqn>
				<units>unitless</units>
			</aux>
			<aux name="molar gas constant (R)">
				<eqn>8.314</eqn>
				<units>J/mol*K</units>
			</aux>
			<aux name="water opacity (t(H2O))">
				<eqn>0.0126*(&quot;relative_humidity_(pH2O)&quot;^0.503)</eqn>
				<units>unitless</units>
			</aux>
			<aux name="vertical opacity of the\ngreenhouse atmosphere (t)">
				<eqn>&quot;methane_opacity_(t(CH4))&quot;+&quot;water_opacity_(t(H2O))&quot;+&quot;carbon_dioxide_opacity_(t(CO2))&quot;</eqn>
				<units>unitless</units>
			</aux>
			<aux name="relative humidity (pH2O)">
				<eqn>&quot;relative_humidity_(H)&quot;*(&quot;water_vapor_saturation_constant_(P0)&quot;*(&quot;exponential_function_(e)&quot;^(-1*(&quot;fall_and_plant_death_-_turnover_(L)&quot;/(&quot;molar_gas_constant_(R)&quot;*&quot;surface_temperature_(Ts)&quot;)))))</eqn>
				<units>Pa</units>
			</aux>
			<aux name="initial Ts">
				<eqn>288.15</eqn>
				<units>K</units>
			</aux>
			<aux name="fall and plant\ndeath - turnover (L)">
				<eqn>43655</eqn>
				<units>J/mol</units>
			</aux>
			<aux name="carbon dioxide opacity (t(CO2))">
				<eqn>1.73*&quot;partial_pressure_of_CO2_(pCO2)&quot;^0.263</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Anomaly" access="output">
				<eqn>&quot;surface_temperature_(Ts)&quot;-initial_Ts</eqn>
				<units>K</units>
			</aux>
			<aux name="partial pressure of CO2 (pCO2)">
				<eqn>Atmospheric_Carbon/&quot;mole_volume_of_the_atmosphere_(ka)&quot;*&quot;pre-industrial_moles_of_molecules_in_the_atmosphere_(fgtm)&quot;</eqn>
				<units>ppm</units>
			</aux>
			<aux name="outgoing radiation">
				<eqn>&quot;Stefan-Boltzman_Constant_(sigma)&quot;*(&quot;surface_temperature_(Ts)&quot;^4)</eqn>
				<units>W m^-2</units>
			</aux>
			<aux name="energy balance">
				<eqn>incoming_radiation-outgoing_radiation</eqn>
				<units>W m^-2</units>
			</aux>
			<aux name="global energy balance">
				<eqn>energy_balance*&quot;Earth&apos;s_Surface_Area_(aE)&quot;</eqn>
				<units>w</units>
			</aux>
			<flow name="global temperature change">
				<eqn>&quot;Earth&apos;s_Surface_Area_(aE)&quot;*(1/&quot;Specific_Heat_Capacity_(c)&quot;)*(incoming_radiation-&quot;Stefan-Boltzman_Constant_(sigma)&quot;*&quot;surface_temperature_(Ts)&quot;^4)* 3.154e+7</eqn>
				<units>K/Year</units>
			</flow>
			<aux name="mole volume of the atmosphere (ka)">
				<eqn>1.773e20</eqn>
				<units>mol</units>
			</aux>
			<aux name="pre-industrial\nmoles of molecules in\nthe atmosphere (fgtm)">
				<eqn>8.3259e13</eqn>
				<units>mol/pgC</units>
			</aux>
			<stock name="Atmospheric Carbon" access="input">
				<eqn>600</eqn>
				<non_negative/>
				<units>PgC</units>
			</stock>
			<module name="Carbon" isee:label="">
				<connect to="Carbon.Anomaly" from=".Anomaly"/>
				<connect2 to="Carbon.Anomaly" from="Anomaly"/>
				<connect to='Carbon."partial_pressure_of_CO2_(pCO2)"' from='."partial_pressure_of_CO2_(pCO2)"'/>
				<connect2 to='Carbon."partial_pressure_of_CO2_(pCO2)"' from='"partial_pressure_of_CO2_(pCO2)"'/>
				<connect to='Carbon."surface_temperature_(Ts)"' from='."surface_temperature_(Ts)"'/>
				<connect2 to='Carbon."surface_temperature_(Ts)"' from='"surface_temperature_(Ts)"'/>
			</module>
		</variables>
