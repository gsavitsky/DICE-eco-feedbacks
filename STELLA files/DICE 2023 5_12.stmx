	</model>
	<model name="Climate">
		<variables>
			<stock name="Deep ocean temperature anomaly (T1)">
				<eqn>0.1477</eqn>
				<inflow>Flow_5</inflow>
				<units>°C from 1765</units>
			</stock>
			<stock name="Upper ocean temperature anomaly (T2)">
				<eqn>1.099454</eqn>
				<inflow>Flow_6</inflow>
				<units>°C from 1765</units>
			</stock>
			<aux name="thermal equilibration\nparameter for box 1 (Teq1)">
				<eqn>0.324</eqn>
				<units>m^2/kW</units>
			</aux>
			<aux name="thermal equilibration\nparameter for box 2 (Teq2)">
				<eqn>0.44</eqn>
				<units>m^2/kW</units>
			</aux>
			<flow name="Flow 5">
				<eqn>(&quot;thermal_equilibration_parameter_for_box_1_(Teq1)&quot;*&quot;radiative_forcing_(F)&quot; - &quot;Deep_ocean_temperature_anomaly_(T1)&quot;)/&quot;thermal_response_time_for_box_1_(d1)&quot;</eqn>
				<units>°C from 1765/Year</units>
			</flow>
			<flow name="Flow 6">
				<eqn>(&quot;thermal_equilibration_parameter_for_box_2_(Teq2)&quot;*&quot;radiative_forcing_(F)&quot; - &quot;Upper_ocean_temperature_anomaly_(T2)&quot;)/&quot;thermal_response_time_for_box_2_(d2)&quot;</eqn>
				<units>°C from 1765/Year</units>
			</flow>
			<aux name="radiative forcing (F)">
				<eqn>fco22x * (LN(atmospheric_carbon/&quot;pre-industrial_equilibrium_atosmpheric_carbon_(Meq)&quot;) / LN(2)) + &quot;Miscellaneous_forcing_(Fmisc)&quot; + FGHGexo</eqn>
				<units>W/m^2</units>
			</aux>
			<aux name="thermal response time for box 1 (d1)">
				<eqn>236</eqn>
				<units>Years</units>
			</aux>
			<aux name="thermal response time\nfor box 2 (d2)">
				<eqn>4.07</eqn>
				<units>Years</units>
			</aux>
			<aux name="Atmospheric temperature anomaly (TATM)" access="output" isee:autocreated="true">
				<eqn>&quot;Deep_ocean_temperature_anomaly_(T1)&quot;+&quot;Upper_ocean_temperature_anomaly_(T2)&quot;</eqn>
				<units>°C from 1765</units>
			</aux>
			<aux name="Miscellaneous forcing 2020 (Fmisc0)">
				<eqn>-0.054</eqn>
				<units>W/m^2</units>
			</aux>
			<aux name="Miscellaneous forcing\n2100 (Fmisc80)">
				<eqn>0.265</eqn>
				<units>W/m^2</units>
			</aux>
			<aux name="Miscellaneous forcing (Fmisc)">
				<eqn>IF TIME &gt;= 2100 THEN &quot;Miscellaneous_forcing_2100_(Fmisc80)&quot;
ELSE &quot;Miscellaneous_forcing_2020_(Fmisc0)&quot; + (&quot;Miscellaneous_forcing_2100_(Fmisc80)&quot; - &quot;Miscellaneous_forcing_2020_(Fmisc0)&quot;) / (2100 - 2020) * (TIME - 2020)</eqn>
				<units>W/m^2</units>
			</aux>
			<group name="Climate model" run="false">
				<entity name='"Atmospheric_temperature_anomaly_(TATM)"'/>
				<entity name='"Deep_ocean_temperature_anomaly_(T1)"'/>
				<entity name='"Miscellaneous_forcing_(Fmisc)"'/>
				<entity name='"Miscellaneous_forcing_2020_(Fmisc0)"'/>
				<entity name='"Miscellaneous_forcing_2100_(Fmisc80)"'/>
				<entity name='"pre-industrial_equilibrium_atosmpheric_carbon_(Meq)"'/>
				<entity name='"radiative_forcing_(F)"'/>
				<entity name='"thermal_equilibration_parameter_for_box_1_(Teq1)"'/>
				<entity name='"thermal_equilibration_parameter_for_box_2_(Teq2)"'/>
				<entity name='"thermal_response_time_for_box_1_(d1)"'/>
				<entity name='"thermal_response_time_for_box_2_(d2)"'/>
				<entity name='"Upper_ocean_temperature_anomaly_(T2)"'/>
				<entity name="fco22x"/>
				<entity name="FGHGexo"/>
				<entity name="Flow_5"/>
				<entity name="Flow_6"/>
			</group>
			<aux name="fco22x">
				<eqn>3.93</eqn>
			</aux>
			<aux name="FGHGexo">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2419.99999999998"/>
					<yscale min="-1" max="1"/>
					<ypts>0.518,0.5363601,0.55038826,0.55120014,0.55076855,0.54897819,0.54536617,0.53946122,0.53222445,0.52334681,0.51253906,0.49953035,0.48406722,0.46591284,0.44484667,0.42066399,0.39317499,0.36220223,0.32824301,0.29151208,0.25218467,0.21038755,0.16634118,0.12841726,0.09576476,0.06765096,0.04344497,0.02260362,0.00465922,-0.0107909,-0.0240935,-0.035547,-0.0454085,-0.0538992,-0.0612097,-0.067504,-0.0729235,-0.0775896,-0.0742059,-0.0712925,-0.0687841,-0.0666244,-0.0647648,-0.0631638,-0.0617853,-0.0605984,-0.0595764,-0.0586966,-0.057939,-0.0572867,-0.0567251,-0.0562416,-0.0558252,-0.0554668,-0.0551582,-0.0548924,-0.0546636,-0.0544666,-0.0468958,-0.0403773,-0.0347648,-0.0299325,-0.0257719,-0.0221896,-0.0191052,-0.0164496,-0.0141631,-0.0121944,-0.0104994,-0.00904,-0.0077834,-0.0067015,-0.00577,-0.004968,-0.0042774,-0.0036829,-0.003171,-0.0027302,-0.0023507,-0.002024,-0.0017426</ypts>
				</gf>
			</aux>
			<aux name="exo MAT">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2419.99999999998"/>
					<yscale min="0" max="3000"/>
					<ypts>886.512801,915.718548,939.764112,964.666602,989.779729,1014.69061,1039.00318,1063.15946,1086.81608,1109.65347,1131.32935,1151.46523,1169.63953,1185.38216,1198.16958,1207.4198,1212.48658,1213.49777,1209.74566,1200.48963,1184.91712,1162.28737,1141.22492,1120.90121,1100.85246,1080.80714,1060.59616,1040.10526,1019.25206,997.993685,976.296654,954.134817,931.488667,908.345453,884.699919,860.555741,835.927945,829.78753,820.481854,809.646967,797.895109,785.454903,772.417384,758.826544,744.711735,730.099082,715.015585,699.49075,683.557387,667.252095,650.615539,633.692518,616.531712,599.185037,581.706561,564.151087,546.572854,567.900727,579.841251,588.165158,594.191333,598.717285,602.255539,605.136156,607.571919,609.700202,611.609879,613.358637,614.984113,616.511065,617.955982,619.330041,620.641008,621.894457,623.094547,624.244521,625.34702,626.40429,627.418309,628.390866,629.323621</ypts>
				</gf>
			</aux>
			<module name="DICE CARBON" isee:label="">
				<connect to='DICE_CARBON."Atmospheric_temperature_anomaly_(TATM)"' from='Climate."Atmospheric_temperature_anomaly_(TATM)"'/>
				<connect2 to='DICE_CARBON."Atmospheric_temperature_anomaly_(TATM)"' from='"Atmospheric_temperature_anomaly_(TATM)"'/>
				<connect to='DICE_CARBON."cumulative_carbon_emissions_(Ctot)"' from='Economy."cumulative_carbon_emissions_(Ctot)"'/>
				<connect2 to='DICE_CARBON."cumulative_carbon_emissions_(Ctot)"' from='Economy."cumulative_carbon_emissions_(Ctot)"'/>
				<connect to='DICE_CARBON."pre-industrial_equilibrium_atosmpheric_carbon_(Meq)"' from='Climate."pre-industrial_equilibrium_atosmpheric_carbon_(Meq)"'/>
				<connect2 to='DICE_CARBON."pre-industrial_equilibrium_atosmpheric_carbon_(Meq)"' from='"pre-industrial_equilibrium_atosmpheric_carbon_(Meq)"'/>
				<connect to='DICE_CARBON."total_CO2_emissions_(ECo2)"' from='Economy."total_CO2_emissions_(ECo2)"'/>
				<connect2 to='DICE_CARBON."total_CO2_emissions_(ECo2)"' from='Economy."total_CO2_emissions_(ECo2)"'/>
			</module>
			<module name="Lenton Carbon" isee:label="">
				<connect to="Climate.atmospheric_carbon_1" from="Lenton_Carbon.Atmospheric_Carbon"/>
				<connect2 to="atmospheric_carbon_1" from="Lenton_Carbon.Atmospheric_Carbon"/>
				<connect to="Lenton_Carbon.anomaly_1" from='Climate."Atmospheric_temperature_anomaly_(TATM)"'/>
				<connect2 to="Lenton_Carbon.anomaly_1" from='"Atmospheric_temperature_anomaly_(TATM)"'/>
				<connect to="Lenton_Carbon.EIND" from='Economy."total_CO2_emissions_(ECo2)"'/>
				<connect2 to="Lenton_Carbon.EIND" from='Economy."total_CO2_emissions_(ECo2)"'/>
				<connect to="Permafrost_dynamics.Anomaly" from='Climate."Atmospheric_temperature_anomaly_(TATM)"'/>
				<connect2 to="Permafrost_dynamics.Anomaly" from='"Atmospheric_temperature_anomaly_(TATM)"'/>
			</module>
			<aux name="total CO2 emissions (ECo2)" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>GtCO2/year</units>
			</aux>
			<stock name="atmospheric carbon 1" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<aux name="pre-industrial equilibrium\natosmpheric carbon (Meq)" access="output" isee:autocreated="true">
				<eqn>588</eqn>
				<units>GtC</units>
			</aux>
			<aux name="Lenton?">
				<eqn>1</eqn>
				<format precision="1"/>
				<scale min="0" max="1"/>
				<range min="0" max="1"/>
			</aux>
			<aux name="atmospheric carbon">
				<eqn>IF &quot;Lenton?&quot; = 1 THEN atmospheric_carbon_1 ELSE exo_MAT</eqn>
			</aux>
		</variables>
