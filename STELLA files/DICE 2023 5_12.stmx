					<to>Flow_3</to>
				</connector>
				<connector uid="12" angle="109.092">
					<from>&quot;total_CO2_emissions_(ECo2)&quot;</from>
					<to>Flow_3</to>
				</connector>
				<flow x="615.767" y="549.918" name="Flow 4">
					<pts>
						<pt x="615.767" y="485.863"/>
						<pt x="615.767" y="604.972"/>
					</pts>
				</flow>
				<connector uid="13" angle="81.8914">
					<from>&quot;total_CO2_emissions_(ECo2)&quot;</from>
					<to>Flow_4</to>
				</connector>
				<connector uid="14" angle="256.993">
					<from>&quot;Emission_share_into_reservoir_3_(ϵ3)&quot;</from>
					<to>Flow_4</to>
				</connector>
				<connector uid="15" angle="277.15">
					<from>&quot;Decay_time_constant_for_reservoir_3_(τ3)&quot;</from>
					<to>Flow_4</to>
				</connector>
				<connector uid="16" angle="112.53">
					<from>&quot;Carbon_Reservoir_3_(R3)&quot;</from>
					<to>Flow_4</to>
				</connector>
				<aux x="230.767" y="921.969" name="carbon accumulated in ocean and land sinks (Cacc)"/>
				<aux x="362.937" y="1027.11" name="Atmospheric carbon concentration (MAT)"/>
				<connector uid="17" angle="301.461">
					<from>&quot;Carbon_Reservoir_0_(R0)&quot;</from>
					<to>&quot;Atmospheric_carbon_concentration_(MAT)&quot;</to>
				</connector>
				<connector uid="18" angle="280.083">
					<from>&quot;Carbon_Reservoir_1_(R1)&quot;</from>
					<to>&quot;Atmospheric_carbon_concentration_(MAT)&quot;</to>
				</connector>
				<connector uid="19" angle="299.211">
					<from>&quot;Carbon_Reservoir_2_(R2)&quot;</from>
					<to>&quot;Atmospheric_carbon_concentration_(MAT)&quot;</to>
				</connector>
				<connector uid="20" angle="289.222">
					<from>&quot;Carbon_Reservoir_3_(R3)&quot;</from>
					<to>&quot;Atmospheric_carbon_concentration_(MAT)&quot;</to>
				</connector>
				<connector uid="23" angle="106.589">
					<from>&quot;Atmospheric_carbon_concentration_(MAT)&quot;</from>
					<to>&quot;carbon_accumulated_in_ocean_and_land_sinks_(Cacc)&quot;</to>
				</connector>
				<aux x="290.607" y="43.6826" name="IRF100"/>
				<aux x="399.317" y="61.6826" name="IRF0"/>
				<aux x="381.317" y="123.878" name="Sensitivity of IRF to\ncumulative carbon uptake (irC)"/>
				<aux x="236.697" y="131.31" name="Sensitivity of IRF\nto temperature (irT)"/>
				<connector uid="24" angle="12.1315">
					<from>&quot;Atmospheric_temperature_anomaly_(TATM)&quot;</from>
					<to>IRF100</to>
				</connector>
				<connector uid="25" angle="138.522">
					<from>&quot;Sensitivity_of_IRF_to_cumulative_carbon_uptake_(irC)&quot;</from>
					<to>IRF100</to>
				</connector>
				<connector uid="26" angle="58.3983">
					<from>&quot;Sensitivity_of_IRF_to_temperature_(irT)&quot;</from>
					<to>IRF100</to>
				</connector>
				<connector uid="27" angle="39.58">
					<from>
						<alias uid="28"/>
					</from>
					<to>IRF100</to>
				</connector>
				<stock font_style="italic" font_weight="bold" x="158.107" y="866.937" name="cumulative carbon\nemissions (Ctot)"/>
				<connector uid="29" angle="322.86">
					<from>&quot;cumulative_carbon_emissions_(Ctot)&quot;</from>
					<to>&quot;carbon_accumulated_in_ocean_and_land_sinks_(Cacc)&quot;</to>
				</connector>
				<group locked="true" x="77.5074" y="26.4605" width="379.76" height="220.694" name="Carbon cycle scaling">
					<item uid="28"/>
				</group>
				<group locked="true" x="76.3974" y="806.863" width="368.741" height="288.692" name="Atmospheric Carbon"/>
				<group locked="true" x="76.0374" y="285.029" width="635.63" height="492.662" name="Ocean + Terrestrial Carbon"/>
				<aux x="212.767" y="214.763" name="alpha"/>
				<connector uid="30" angle="226.751">
					<from>alpha</from>
					<to>Flow_1</to>
				</connector>
				<connector uid="31" angle="311.576">
					<from>alpha</from>
					<to>Flow_3</to>
				</connector>
				<connector uid="32" angle="324.753">
					<from>alpha</from>
					<to>Flow_2</to>
				</connector>
				<connector uid="33" angle="26.6614">
					<from>alpha</from>
					<to>Flow_4</to>
				</connector>
				<connector uid="34" angle="151.808">
					<from>IRF0</from>
					<to>IRF100</to>
				</connector>
				<connector uid="35" angle="282.102">
					<from>IRF100</from>
					<to>alpha</to>
				</connector>
				<aux color="blue" background="white" font_style="italic" font_weight="bold" x="133.547" y="43.6826" name="Atmospheric temperature anomaly (TATM)">
					<shape type="circle" radius="18"/>
				</aux>
				<aux font_style="italic" font_weight="bold" x="180.908" y="1007.89" name="pre-industrial equilibrium\natosmpheric carbon (Meq)"/>
				<connector uid="36" angle="48.78">
					<from>&quot;pre-industrial_equilibrium_atosmpheric_carbon_(Meq)&quot;</from>
					<to>&quot;carbon_accumulated_in_ocean_and_land_sinks_(Cacc)&quot;</to>
				</connector>
				<connector uid="37" angle="5.74319">
					<from>&quot;pre-industrial_equilibrium_atosmpheric_carbon_(Meq)&quot;</from>
					<to>&quot;Atmospheric_carbon_concentration_(MAT)&quot;</to>
				</connector>
				<alias color="blue" background="white" font_style="italic" uid="28" x="129.387" y="104.31" width="18" height="18">
					<shape type="circle" radius="18"/>
					<of>&quot;carbon_accumulated_in_ocean_and_land_sinks_(Cacc)&quot;</of>
				</alias>
			</view>
		</views>
	</model>
	<model name="Lenton_Carbon">
		<variables>
			<stock name="Atmospheric Carbon" access="output" isee:autocreated="true">
				<eqn>Ca0</eqn>
				<inflow>Plant_Respiration</inflow>
				<inflow>Soil_Respiration</inflow>
				<inflow>&quot;Air-Sea_Exchange_(LL)&quot;</inflow>
				<inflow>&quot;Air-Sea_Exchange_(HL)&quot;</inflow>
				<inflow>GHG_emissions</inflow>
				<inflow>Permafrost_melt</inflow>
				<outflow>Photosynthesis</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<stock name="Vegetation Carbon">
				<eqn>Cv0</eqn>
				<inflow>Photosynthesis</inflow>
				<outflow>Plant_Respiration</outflow>
				<outflow>Turnover</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<stock name="Soil Carbon">
				<eqn>Cs0</eqn>
				<inflow>Turnover</inflow>
				<outflow>Soil_Respiration</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<flow name="Photosynthesis">
				<eqn>(&quot;photosynthesis_rate_(kp)&quot;*&quot;Cv(s)&quot;*&quot;photosynthesis_normalizing_constant_(kMM)&quot;)*

((pCO2_ppmv-&quot;compensation_point_(kc)&quot;)/(&quot;Half_saturation_point_(KM)&quot;+(pCO2_ppmv-&quot;compensation_point_(kc)&quot;)))*

((15+anomaly)^2)*(25-anomaly)/5625</eqn>
				<non_negative/>
				<units>pgC/Years</units>
			</flow>
			<flow name="Plant Respiration">
				<eqn>IF &quot;temp-resp_switch_veg&quot; = 1 THEN &quot;plant_respiration_rate_(kr)&quot; * Vegetation_Carbon * &quot;plant_respiration_normalizing_constant_(kA)&quot; * EXP(-&quot;Plant_respiration_activation_energy_(Ea)&quot; / (R * surface_temp))

ELSE
&quot;plant_respiration_rate_(kr)&quot; * Vegetation_Carbon * &quot;plant_respiration_normalizing_constant_(kA)&quot; * EXP(-&quot;Plant_respiration_activation_energy_(Ea)&quot; / (R * 288))</eqn>
				<non_negative/>
				<units>pgC/Years</units>
			</flow>
			<flow name="Turnover">
				<eqn>&quot;turnover_rate_(kt)&quot;*Vegetation_Carbon</eqn>
				<non_negative/>
				<units>pgC/Years</units>
			</flow>
			<flow name="Soil Respiration">
				<eqn>IF &quot;temp-resp_switch_soil&quot; = 1 THEN &quot;soil_respiration_rate_(ksr)&quot;*Soil_Carbon*&quot;soil_respiration_normalizing_constant_(kB)&quot;* 2.7^(-1*(308.56/(surface_temp -227.13)))

ELSE
&quot;soil_respiration_rate_(ksr)&quot;*Soil_Carbon*&quot;soil_respiration_normalizing_constant_(kB)&quot;* 2.7^(-1*(308.56/(288 -227.13)))</eqn>
				<non_negative/>
				<units>pgC/Years</units>
			</flow>
			<stock name="Low Latitude Ocean Carbon">
				<eqn>Col0</eqn>
				<inflow>&quot;intermediate-warm_exchange&quot;</inflow>
				<outflow>&quot;Air-Sea_Exchange_(LL)&quot;</outflow>
				<outflow>&quot;Warm-intermediate_Ocean_exchange&quot;</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<stock name="High Latitude Surface Ocean Carbon">
				<eqn>Coh0</eqn>
				<outflow>&quot;Air-Sea_Exchange_(HL)&quot;</outflow>
				<outflow>&quot;cold-intermediate_ocean_exchange&quot;</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<stock name="Intermediate Ocean Carbon">
				<eqn>Coi0</eqn>
				<inflow>&quot;Warm-intermediate_Ocean_exchange&quot;</inflow>
				<inflow>&quot;cold-intermediate_ocean_exchange&quot;</inflow>
				<inflow>&quot;deep-intermediate_exchange&quot;</inflow>
				<outflow>&quot;Intermediate-deep_Ocean_exchange&quot;</outflow>
				<outflow>&quot;intermediate-warm_exchange&quot;</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<stock name="Deep Ocean Carbon">
				<eqn>Cod0</eqn>
				<inflow>&quot;Intermediate-deep_Ocean_exchange&quot;</inflow>
				<outflow>&quot;deep-intermediate_exchange&quot;</outflow>
				<non_negative/>
				<units>pgC</units>
			</stock>
			<flow name="Air-Sea Exchange (LL)">
				<eqn>-Faw</eqn>
				<units>pgC/Years</units>
			</flow>
			<flow name="Air-Sea Exchange (HL)">
				<eqn>-Fac</eqn>
				<units>pgC/Years</units>
			</flow>
			<aux name="photosynthesis rate (kp)">
				<eqn>0.184</eqn>
				<units>1/year</units>
			</aux>
			<aux name="plant respiration rate (kr)">
				<eqn>0.092</eqn>
				<units>1/year</units>
			</aux>
			<aux name="turnover rate (kt)">
				<eqn>0.092</eqn>
				<units>1/year</units>
			</aux>
			<aux name="soil respiration rate (ksr)">
				<eqn>0.0337</eqn>
				<units>1/year</units>
			</aux>
			<aux name="Half saturation point (KM)">
				<eqn>120</eqn>
				<units>ppmv</units>
			</aux>
			<aux name="Plant respiration activation energy (Ea)">
				<eqn>54830</eqn>
				<units>J/mol</units>
			</aux>
			<aux name="photosynthesis normalizing constant (kMM)">
				<eqn>1.478</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="plant respiration\nnormalizing constant (kA)">
				<eqn>8.7039e9</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="thermohaline overturning (kT)">
				<eqn>6.5e7</eqn>
				<units>m^3/s</units>
			</aux>
			<aux name="high latitude overturning (kU)">
				<eqn>4.87e7</eqn>
				<units>m^3/s</units>
			</aux>
			<aux name="warm-intermediate exchange (kwi)">
				<eqn>1.25e7</eqn>
				<units>m^3/s</units>
			</aux>
			<aux name="intermediate-deep exchange (kid)">
				<eqn>2e8</eqn>
				<units>m^3/s</units>
			</aux>
			<aux name="piston velocity (ks)">
				<eqn>1752</eqn>
				<units>m/year</units>
			</aux>
			<aux name="compensation point (kc)">
				<eqn>29</eqn>
				<units>ppmv</units>
			</aux>
			<aux name="soil respiration normalizing constant (kB)">
				<eqn>157.072</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="anomaly 1" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>°C from 1765</units>
			</aux>
			<aux name="Cs0">
				<eqn>1500</eqn>
			</aux>
			<aux name="Ca0">
				<eqn>887</eqn>
				<units>pgC</units>
			</aux>
			<aux name="Cv0">
				<eqn>550</eqn>
				<units>pgC</units>
			</aux>
			<aux name="kD">
				<eqn>0.27</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="Cv(s)">
				<eqn>Cv0-(cumulative_deforestation*kD)</eqn>
			</aux>
			<stock name="cumulative deforestation">
				<eqn>0</eqn>
				<inflow>&quot;Deforestation_(D)&quot;</inflow>
				<non_negative/>
				<units>PgC</units>
			</stock>
			<flow name="Deforestation (D)">
				<eqn>eland/2.12</eqn>
				<non_negative/>
				<units>PgC/Year</units>
			</flow>
			<group name="Land Use Change" run="false">
				<entity name='"Cv(s)"'/>
				<entity name='"Deforestation_(D)"'/>
				<entity name="cumulative_deforestation"/>
				<entity name="deland"/>
				<entity name="eland"/>
				<entity name="eland0"/>
				<entity name="kD"/>
			</group>
			<aux name="R">
				<eqn>8.314</eqn>
				<units>J/mol*K</units>
			</aux>
			<group name="Initialization" run="false">
				<entity name="Ca0"/>
				<entity name="Cod0"/>
				<entity name="Coh0"/>
				<entity name="Coi0"/>
				<entity name="Col0"/>
				<entity name="Cs0"/>
				<entity name="Cv0"/>
			</group>
			<aux name="Th">
				<eqn>275.15</eqn>
				<units>K</units>
			</aux>
			<aux name="Tl">
				<eqn>295.15</eqn>
				<units>K</units>
			</aux>
			<aux name="Faw">
				<eqn>IF Ocean_CO2_switch = 1 THEN &quot;piston_velocity_(ks)&quot;*aO*Al*bw*(&quot;partial_pressure_of_CO2_(pCO2)&quot;-&quot;pCO2(w)&quot;)*12e-15*rho

ELSE
&quot;piston_velocity_(ks)&quot;*aO*Al*bw*(0.0004165-&quot;pCO2(w)&quot;)*12e-15*rho</eqn>
			</aux>
			<aux name="Al">
				<eqn>0.85</eqn>
			</aux>
			<aux name="Ah">
				<eqn>0.15</eqn>
			</aux>
			<aux name="pCO2(w)">
				<eqn>&quot;pCO2(w)0&quot; * (Low_Latitude_Ocean_Carbon / Col0)^&quot;beta_(revelle_factor)&quot;</eqn>
			</aux>
			<aux name="pCO2(c)">
				<eqn>&quot;pCO2(c)0&quot; * (High_Latitude_Surface_Ocean_Carbon / Coh0)^&quot;beta_(revelle_factor)&quot;</eqn>
			</aux>
			<aux name="bw">
				<eqn>EXP(-60.2409 + 93.4517*(100/Tl) + 23.3585*LN(Tl/100) 
         + 34.7*(0.023517 - 0.023656*(Tl/100) + 0.0047036*(Tl/100)^2))</eqn>
				<units>mol/kg atm</units>
			</aux>
			<aux name="aO">
				<eqn>3.6e14</eqn>
				<units>m^2</units>
			</aux>
			<aux name="Fac">
				<eqn>IF Ocean_CO2_switch = 1 THEN

&quot;piston_velocity_(ks)&quot;*aO*Ah*bc*(&quot;partial_pressure_of_CO2_(pCO2)&quot;-&quot;pCO2(c)&quot;)*12e-15*rho

ELSE &quot;piston_velocity_(ks)&quot;*aO*Ah*bc*(0.0004165-&quot;pCO2(c)&quot;)*12e-15*rho</eqn>
			</aux>
			<aux name="bc">
				<eqn>EXP(-60.2409 + 93.4517*(100/Th) + 23.3585*LN(Th/100) 
         + 34.7*(0.023517 - 0.023656*(Th/100) + 0.0047036*(Th/100)^2))</eqn>
				<units>mol/kg atm</units>
			</aux>
			<flow name="Warm-intermediate Ocean exchange">
				<eqn>&quot;warm-intermediate_exchange_(kwi)&quot; * (Low_Latitude_Ocean_Carbon / Vl) * 3.15576e7 *12e-15</eqn>
				<non_negative/>
				<units>pgC/Years</units>
			</flow>
			<flow name="Intermediate-deep Ocean exchange">
				<eqn>&quot;intermediate-deep_exchange_(kid)&quot; * (Intermediate_Ocean_Carbon / Vi) * 3.15576e7 * 12e-15</eqn>
				<non_negative/>
				<units>pgC/Years</units>
			</flow>
			<aux name="beta (revelle factor)">
				<eqn>11</eqn>
			</aux>
			<aux name="pCO2(w)0">
				<eqn>286e-6</eqn>
			</aux>
			<aux name="pCO2(c)0">
				<eqn>270e-6</eqn>
			</aux>
			<aux name="Col0">
				<eqn>730</eqn>
				<units>pgC</units>
			</aux>
			<aux name="Coh0">
				<eqn>140</eqn>
				<units>pgC</units>
			</aux>
			<aux name="rho">
				<eqn>1027</eqn>
				<units>kg/m^2</units>
			</aux>
			<aux name="Coi0">
				<eqn>10040</eqn>
			</aux>
			<aux name="Cod0">
				<eqn>23860</eqn>
				<units>pgC</units>
			</aux>
			<flow name="cold-intermediate ocean exchange">
				<eqn>&quot;high_latitude_overturning_(kU)&quot; * (High_Latitude_Surface_Ocean_Carbon / Vh) * 3.15576e7 *12e-15</eqn>
				<non_negative/>
				<units>pgC/Years</units>
			</flow>
			<aux name="Vl">
				<eqn>3.06e16</eqn>
				<units>m^3</units>
			</aux>
			<aux name="Vh">
				<eqn>5.4e15</eqn>
				<units>m^3</units>
			</aux>
			<aux name="Vi">
				<eqn>3.6e17</eqn>
				<units>m^3</units>
			</aux>
			<aux name="Vd">
				<eqn>9.7e17</eqn>
				<units>m^3</units>
			</aux>
			<flow name="deep-intermediate exchange">
				<eqn>&quot;intermediate-deep_exchange_(kid)&quot; * (Deep_Ocean_Carbon / Vd) * 3.15576e7 * 12e-15</eqn>
				<non_negative/>
				<units>pgC/Years</units>
			</flow>
			<flow name="intermediate-warm exchange">
				<eqn>(&quot;thermohaline_overturning_(kT)&quot; + &quot;warm-intermediate_exchange_(kwi)&quot;) * (Intermediate_Ocean_Carbon / Vi) * 3.15576e7 * 12e-15</eqn>
				<non_negative/>
				<units>pgC/Years</units>
			</flow>
			<aux name="pCO2 ppmv">
				<eqn>IF Terr_CO2_switch = 1 THEN  &quot;partial_pressure_of_CO2_(pCO2)&quot;*1e6
ELSE 0.0004165</eqn>
			</aux>
			<flow name="GHG emissions">
				<eqn>EIND*0.2727</eqn>
				<units>pgC/Year</units>
			</flow>
			<aux name="EIND" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>GtCO2/year</units>
			</aux>
			<flow name="Permafrost melt" access="input">
				<units>pgC/Year</units>
			</flow>
			<module name="Permafrost dynamics" isee:label="">
				<connect to="Lenton_Carbon.Permafrost_melt" from="Permafrost_dynamics.Fthawedatmo"/>
				<connect2 to="Permafrost_melt" from="Permafrost_dynamics.Fthawedatmo"/>
				<connect to="Permafrost_dynamics.Anomaly" from='Climate."Atmospheric_temperature_anomaly_(TATM)"'/>
				<connect2 to="Permafrost_dynamics.Anomaly" from='Climate."Atmospheric_temperature_anomaly_(TATM)"'/>
			</module>
			<aux name="eland0">
				<doc>Carbon emissions from land in 2015 (GtCO2 per year)</doc>
				<eqn>2.6</eqn>
				<units>GtCO2/Year</units>
			</aux>
			<aux name="deland">
				<doc>Rate of decline land emissions per year</doc>
				<eqn>0.022009596</eqn>
				<units>1/Year</units>
			</aux>
			<aux name="eland">
				<eqn>eland0 * (1-deland)^(TIME-2015)</eqn>
			</aux>
			<group name="Ocean Chem" run="false">
				<entity name='"beta_(revelle_factor)"'/>
				<entity name='"pCO2(c)"'/>
				<entity name='"pCO2(c)0"'/>
				<entity name='"pCO2(w)"'/>
				<entity name='"pCO2(w)0"'/>
				<entity name='"piston_velocity_(ks)"'/>
				<entity name="Ah"/>
