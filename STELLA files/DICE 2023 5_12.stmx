					<from>&quot;Decay_time_constant_for_reservoir_1_(τ1)&quot;</from>
					<to>Flow_2</to>
				</connector>
				<connector uid="6" angle="236.302">
					<from>&quot;Emission_share_into_reservoir_1_(ϵ1)&quot;</from>
