			<aux name="partial pressure\nof CO2 (pCO2)" access="output" isee:autocreated="true">
				<eqn>Atmospheric_Carbon/&quot;mole_volume_of_the_atmosphere_(ka)&quot;*&quot;pre-industrial_moles_of_molecules_in_the_atmosphere_(fgtm)&quot;</eqn>
				<units>ppm</units>
			</aux>
			<aux name="mole volume of the atmosphere (ka)">
				<eqn>1.773e20</eqn>
				<units>mol</units>
			</aux>
			<aux name="pre-industrial\nmoles of molecules in\nthe atmosphere (fgtm)">
				<eqn>8.3259e13</eqn>
				<units>mol/pgC</units>
			</aux>
			<aux name="surface temp">
				<eqn>288+(anomaly_1)</eqn>
			</aux>
			<aux name="Ocean CO2 switch">
				<eqn>1</eqn>
			</aux>
			<aux name="Terr CO2 switch">
				<eqn>1</eqn>
			</aux>
			<aux name="photo temp switch">
				<eqn>1</eqn>
			</aux>
			<aux name="anomaly">
				<eqn>IF photo_temp_switch = 1 THEN anomaly_1 ELSE 0</eqn>
			</aux>
			<aux name="temp-resp switch soil">
				<eqn>1</eqn>
			</aux>
			<aux name="temp-resp switch veg">
				<eqn>1</eqn>
			</aux>
		</variables>
