				</connector>
				<connector uid="7" angle="56.7548">
					<from>&quot;Carbon_Reservoir_1_(R1)&quot;</from>
					<to>Flow_2</to>
				</connector>
				<connector uid="8" angle="21.2397">
					<from>&quot;total_CO2_emissions_(ECo2)&quot;</from>
					<to>Flow_2</to>
				</connector>
				<flow x="324.237" y="546.663" name="Flow 3">
					<pts>
