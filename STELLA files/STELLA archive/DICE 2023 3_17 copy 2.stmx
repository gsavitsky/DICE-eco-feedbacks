	<model name="Economy">
		<variables>
			<stock name="Capital (K)">
				<eqn>295</eqn>
				<inflow>Change_in_capital</inflow>
				<units>trillion 2019 USD</units>
			</stock>
			<aux name="Investment (I)">
				<eqn>&quot;savings_rate_(s)&quot;*&quot;Output_(Y)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="Depreciation rate\nof capital (dK)">
				<eqn>0.1</eqn>
				<units>/year</units>
			</aux>
			<flow name="Change in capital">
				<eqn>&quot;Investment_(I)&quot; - (-LN(1 - &quot;Depreciation_rate_of_capital_(dK)&quot;)) * &quot;Capital_(K)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</flow>
			<aux name="savings rate (s)">
				<eqn>op_s</eqn>
				<units>fraction</units>
			</aux>
			<aux name="gross output (Ygross)">
				<eqn>exogenous_TFP*(exogenous_pop/1000)^(1-&quot;capital_elasticity_(γ)&quot;)*&quot;Capital_(K)&quot;^&quot;capital_elasticity_(γ)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="damages as fraction\nof gross output (Dfrac)">
				<eqn>a1*&quot;Atmospheric_temperature_anomaly_(TATM)&quot;+a2*&quot;Atmospheric_temperature_anomaly_(TATM)&quot;^a3</eqn>
			</aux>
			<aux name="capital elasticity (γ)">
				<eqn>0.3</eqn>
				<units>unitless</units>
			</aux>
			<aux name="a1">
				<eqn>0</eqn>
				<units>/°C</units>
			</aux>
			<aux name="a2">
				<eqn>0.003467</eqn>
				<units>unitless</units>
			</aux>
			<aux name="a3">
				<eqn>2</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Atmospheric temperature anomaly (TATM)" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>°C from 1765</units>
			</aux>
			<aux name="Economic damages (D)">
				<eqn>&quot;damages_as_fraction_of_gross_output_(Dfrac)&quot;*&quot;gross_output_(Ygross)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<group name="Carbon Intensity" run="false">
				<entity name="exogenous_sigma"/>
			</group>
			<group name="TFP" run="false">
				<entity name="exogenous_TFP"/>
			</group>
			<group name="Population" run="false">
				<entity name="exogenous_pop"/>
			</group>
			<group name="Capital" run="false">
				<entity name='"Capital_(K)"'/>
				<entity name='"consumption_(C)"'/>
				<entity name='"Depreciation_rate_of_capital_(dK)"'/>
				<entity name='"Investment_(I)"'/>
				<entity name='"Output_(Y)"'/>
				<entity name='"per_capital_consumption_(c)"'/>
				<entity name='"savings_rate_(s)"'/>
				<entity name="Change_in_capital"/>
			</group>
			<group name="Damages to Econ" run="false">
				<entity name='"Atmospheric_temperature_anomaly_(TATM)"'/>
				<entity name='"damages_as_fraction_of_gross_output_(Dfrac)"'/>
				<entity name='"Economic_damages_(D)"'/>
				<entity name='"net_output_(Ynet)"'/>
				<entity name="a1"/>
				<entity name="a2"/>
				<entity name="a3"/>
			</group>
			<aux name="net output (Ynet)">
				<eqn>&quot;gross_output_(Ygross)&quot;*(1-&quot;damages_as_fraction_of_gross_output_(Dfrac)&quot;)</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="cost of emissions abatement (Cabate)">
				<eqn>&quot;gross_output_(Ygross)&quot;*&quot;total_abatement_cost_factor_(θ1)&quot;*Emissions_control_rate^&quot;cost_function_exponent_(θ2)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="total abatement\ncost factor (θ1)">
				<eqn>(&quot;total_emissions_intensity_(σtot)&quot;*pback)/(&quot;cost_function_exponent_(θ2)&quot;*1000)</eqn>
			</aux>
			<aux name="cost function exponent (θ2)">
				<eqn>2.6</eqn>
				<units>unitless</units>
			</aux>
			<aux name="pback">
				<eqn>IF TIME-STARTTIME &lt;= 30
            THEN pback2050 * EXP(-0.01 * (TIME - 2050))
            ELSE pback2050 * EXP(-0.001 * (TIME - 2050))</eqn>
				<units>2019 USD/tCO2</units>
			</aux>
			<aux name="marginal cost of abatement (MCabate)">
				<eqn>pback*Emissions_control_rate^(&quot;cost_function_exponent_(θ2)&quot;-1)</eqn>
				<units>2019 USD/tCO2</units>
			</aux>
			<aux name="initial Population (Linit)">
				<eqn>7752.9</eqn>
				<units>million people</units>
			</aux>
			<aux name="initial output (Ygross0)">
				<eqn>135.7</eqn>
				<units>trillion 2019 USD</units>
			</aux>
			<aux name="initial industrial emissions (Eind0)">
				<eqn>37.56</eqn>
				<units>GtCO2/year</units>
			</aux>
			<aux name="initial control rate (µ0)">
				<eqn>0.05</eqn>
			</aux>
			<aux name="elasticity marginal utility (η)">
				<eqn>0.95</eqn>
				<units>unitless</units>
			</aux>
			<aux name="pure time preference (ρ)">
				<eqn>0.001</eqn>
				<units>/year</units>
			</aux>
			<aux name="climate beta (βclim)">
				<eqn>0.5</eqn>
				<units>unitless</units>
			</aux>
			<aux name="capital risk premium (π)">
				<eqn>0.05</eqn>
				<units>/year</units>
			</aux>
			<aux name="std dev consumption\ngrowth (Vc)">
				<eqn>MIN(annual_SD_of_consumption_growth^2 * ((TIME - STARTTIME)/5), annual_SD_of_consumption_growth^2 * 235)</eqn>
				<units>/year</units>
			</aux>
			<aux name="Emissions control rate" access="output" isee:autocreated="true">
				<eqn>Emissions_control_rate_1</eqn>
			</aux>
			<flow name="emissions accumulating">
				<eqn>&quot;total_CO2_emissions_(ECo2)&quot;/3.666</eqn>
				<units>GtC/Year</units>
			</flow>
			<stock name="cumulative carbon\nemissions (Ctot)" access="output" isee:autocreated="true">
				<eqn>633.5</eqn>
				<inflow>emissions_accumulating</inflow>
				<units>GtC</units>
			</stock>
			<aux name="industrial emissions">
				<eqn>(exogenous_sigma*&quot;gross_output_(Ygross)&quot;
*(1-Emissions_control_rate))</eqn>
			</aux>
			<aux name="land emissions (Eland)">
				<eqn>&quot;initial_land_emissions_(Eland0)&quot; * (1 - &quot;land_emissions_decline_rate_(λland)&quot;)^((TIME - 2020) / 5)</eqn>
				<units>GtCO2/year</units>
			</aux>
			<aux name="total CO2 emissions (ECo2)" access="output" isee:autocreated="true">
				<eqn>(exogenous_sigma*&quot;gross_output_(Ygross)&quot;+&quot;land_emissions_(Eland)&quot;)*(1-Emissions_control_rate)</eqn>
				<units>GtCO2/year</units>
			</aux>
			<aux name="land emissions decline\nrate (λland)">
				<eqn>0.02107</eqn>
				<units>/year</units>
			</aux>
			<group name="Emissions" run="false">
				<entity name='"cumulative_carbon_emissions_(Ctot)"'/>
				<entity name='"initial_land_emissions_(Eland0)"'/>
				<entity name='"land_emissions_(Eland)"'/>
				<entity name='"land_emissions_decline_rate_(λland)"'/>
				<entity name='"total_CO2_emissions_(ECo2)"'/>
				<entity name="emissions_accumulating"/>
				<entity name="Emissions_control_rate"/>
				<entity name="industrial_emissions"/>
			</group>
			<aux name="initial land emissions (Eland0)">
				<eqn>5.9</eqn>
				<units>GtCO2/year</units>
			</aux>
			<aux name="emissions ratio 2020 (remiss0)">
				<eqn>1.4</eqn>
				<units>unitless</units>
			</aux>
			<aux name="emissions ratio 2100 (remiss80)">
				<eqn>1.21</eqn>
				<units>unitless</units>
			</aux>
			<aux name="total emissions intensity (σtot)">
				<eqn>exogenous_sigma*&quot;emissions_ratio_(remiss)&quot;</eqn>
			</aux>
			<aux name="emissions ratio (remiss)">
				<eqn>IF TIME &lt;= 2100 THEN 
                &quot;emissions_ratio_2020_(remiss0)&quot; + (&quot;emissions_ratio_2100_(remiss80)&quot; - &quot;emissions_ratio_2020_(remiss0)&quot;)/80 * (TIME -2020)
             ELSE 
       &quot;emissions_ratio_2100_(remiss80)&quot;</eqn>
			</aux>
			<aux name="pback2050">
				<eqn>515</eqn>
			</aux>
			<aux name="consumption (C)">
				<eqn>&quot;Output_(Y)&quot;-&quot;Investment_(I)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="Output (Y)">
				<eqn>&quot;net_output_(Ynet)&quot;-&quot;cost_of_emissions_abatement_(Cabate)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="per capital consumption (c)">
				<eqn>1000*&quot;consumption_(C)&quot;/exogenous_pop</eqn>
				<units>thousand 2019 USD/ capita/ year</units>
			</aux>
			<aux name="period utility (U)">
				<eqn>((&quot;consumption_(C)&quot;*1000/exogenous_pop)^(1-&quot;elasticity_marginal_utility_(η)&quot;)-1)/(1-&quot;elasticity_marginal_utility_(η)&quot;)-1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="total welfare (W)">
				<eqn>&quot;Accumulated_Utility_(Uacc)&quot;*scale_1+scale_2</eqn>
			</aux>
			<stock name="Accumulated Utility (Uacc)">
				<eqn>0</eqn>
				<inflow>accumulation_of_utility</inflow>
				<units>unitless</units>
			</stock>
			<flow name="accumulation of utility">
				<eqn>total_period_utility</eqn>
				<units>Per Year</units>
			</flow>
			<aux name="risk-adjusted pure time\npreference (ρa)">
				<eqn>EXP( &quot;pure_time_preference_(ρ)&quot; + &quot;climate_beta_(βclim)&quot;*&quot;capital_risk_premium_(π)&quot;)-1</eqn>
				<units>/year</units>
			</aux>
			<aux name="precautionary adjustment (rpre)">
				<eqn>-0.5*&quot;std_dev_consumption_growth_(Vc)&quot;*&quot;elasticity_marginal_utility_(η)&quot;^2</eqn>
			</aux>
			<group name="Utility" run="false">
				<entity name='"Accumulated_Utility_(Uacc)"'/>
				<entity name='"capital_risk_premium_(π)"'/>
				<entity name='"climate_beta_(βclim)"'/>
				<entity name='"elasticity_marginal_utility_(η)"'/>
				<entity name='"period_utility_(U)"'/>
				<entity name='"precautionary_adjustment_(rpre)"'/>
				<entity name='"pure_time_preference_(ρ)"'/>
				<entity name='"risk-adjusted_pure_time_preference_(ρa)"'/>
				<entity name='"std_dev_consumption_growth_(Vc)"'/>
				<entity name="accumulation_of_utility"/>
				<entity name="annual_SD_of_consumption_growth"/>
				<entity name="STP_with_precautionary_factor"/>
				<entity name="STP_without_precautionary_factor"/>
				<entity name="total_period_utility"/>
			</group>
			<group name="Abatement" run="false">
				<entity name='"cost_function_exponent_(θ2)"'/>
				<entity name='"cost_of_emissions_abatement_(Cabate)"'/>
				<entity name='"emissions_ratio_(remiss)"'/>
				<entity name='"emissions_ratio_2020_(remiss0)"'/>
				<entity name='"emissions_ratio_2100_(remiss80)"'/>
				<entity name='"marginal_cost_of_abatement_(MCabate)"'/>
				<entity name='"total_abatement_cost_factor_(θ1)"'/>
				<entity name='"total_emissions_intensity_(σtot)"'/>
				<entity name="pback"/>
				<entity name="pback2050"/>
			</group>
			<group name="Initial conditions" run="false">
				<entity name='"initial_control_rate_(µ0)"'/>
				<entity name='"initial_industrial_emissions_(Eind0)"'/>
				<entity name='"initial_output_(Ygross0)"'/>
				<entity name='"initial_Population_(Linit)"'/>
			</group>
			<group name="Wellfare" run="false">
				<entity name='"total_welfare_(W)"'/>
				<entity name="scale_1"/>
				<entity name="scale_2"/>
			</group>
			<aux name="exogenous pop">
				<eqn>TIME</eqn>
				<gf type="extrapolate">
					<xscale min="2020" max="2419.99999999998"/>
					<yscale min="0" max="100"/>
					<ypts>7752.9,8137.36735,8481.17061,8786.61818,9056.48447,9293.78335,9501.59842,9682.96139,9840.76946,9977.73328,10096.348,10198.8812,10287.3724,10363.641,10429.2989,10485.7662,10534.2881,10575.9523,10611.7059,10642.3711,10668.66,10691.1886,10710.4882,10727.017,10741.1694,10753.2845,10763.6537,10772.5273,10780.1201,10786.6161,10792.1733,10796.927,10800.9931,10804.4708,10807.4451,10809.9888,10812.1641,10814.0244,10815.6152,10816.9755,10818.1386,10819.1333,10819.9838,10820.711,10821.3328,10821.8644,10822.319,10822.7077,10823.0401,10823.3243,10823.5672,10823.775,10823.9526,10824.1045,10824.2343,10824.3453,10824.4402,10824.5214,10824.5908,10824.6501,10824.7009,10824.7442,10824.7813,10824.813,10824.8401,10824.8633,10824.8831,10824.9001,10824.9146,10824.927,10824.9376,10824.9466,10824.9543,10824.961,10824.9666,10824.9715,10824.9756,10824.9791,10824.9822,10824.9848,10824.987</ypts>
				</gf>
			</aux>
			<aux name="exogenous TFP">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2419.99999999998"/>
					<yscale min="0" max="100"/>
					<ypts>5.84,6.25267666,6.69098181,7.15626336,7.64992513,8.17342836,8.72829322,9.31610033,9.9384923,10.5971752,11.29392,12.0305644,12.8090137,13.6312428,14.4992977,15.4152965,16.3814312,17.3999688,18.473253,19.6037056,20.7938274,22.0461999,23.3634862,24.7484329,26.2038705,27.732715,29.337969,31.0227227,32.790155,34.6435342,36.5862193,38.6216608,40.7534013,42.9850763,45.3204153,47.7632419,50.3174747,52.9871276,55.7763106,58.6892296,61.7301874,64.9035834,68.2139139,71.6657722,75.2638486,79.0129305,82.9179018,86.9837432,91.2155314,95.618439,100.197734,104.958779,109.90703,115.048039,120.387446,125.930988,131.684487,137.653859,143.845106,150.264318,156.917669,163.811421,170.951913,178.345571,185.998896,193.918469,202.110945,210.583055,219.3416,228.393451,237.745547,247.40489,257.378548,267.673647,278.297372,289.256962,300.559711,312.212959,324.224097,336.600559,349.349819</ypts>
				</gf>
			</aux>
			<aux name="exogenous sigma">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2419.99999999998"/>
					<yscale min="0" max="100"/>
					<ypts>0.29135477,0.27030249,0.25152482,0.23472665,0.21965683,0.20610082,0.19387479,0.18282066,0.17280212,0.16370121,0.15541561,0.14785623,0.14094538,0.13461505,0.12880558,0.12346449,0.11854553,0.11400781,0.10981509,0.10593521,0.10233955,0.09900259,0.09590152,0.09301592,0.09032746,0.08781967,0.08547772,0.08328823,0.08123183,0.07922621,0.07727011,0.0753623,0.0735016,0.07168684,0.06991689,0.06819063,0.066507,0.06486494,0.06326341,0.06170144,0.06017802,0.05869222,0.0572431,0.05582977,0.05445133,0.05310692,0.0517957,0.05051686,0.0492696,0.04805313,0.04686669,0.04570955,0.04458097,0.04348027,0.04240673,0.04135971,0.04033853,0.03934257,0.0383712,0.03742381,0.03649981,0.03559863,0.0347197,0.03386247,0.0330264,0.03221097,0.03141568,0.03064003,0.02988352,0.02914569,0.02842608,0.02772424,0.02703973,0.02637211,0.02572098,0.02508593,0.02446656,0.02386248,0.02327331,0.02269869,0.02213826</ypts>
				</gf>
			</aux>
			<aux name="scaling factor\ndiscounting (SRF)">
				<eqn>1000000</eqn>
			</aux>
			<aux name="total period utility">
				<eqn>&quot;period_utility_(U)&quot;*exogenous_pop*STP_with_precautionary_factor</eqn>
			</aux>
			<aux name="STP with precautionary factor">
				<eqn>STP_without_precautionary_factor * (1 + &quot;precautionary_adjustment_(rpre)&quot;)^((TIME - STARTTIME)/5)</eqn>
			</aux>
			<aux name="scale 1">
				<eqn>0.00891061</eqn>
			</aux>
			<aux name="scale 2">
				<eqn>-6275.91</eqn>
			</aux>
			<aux name="annual SD of consumption growth">
				<eqn>0.1</eqn>
			</aux>
			<aux name="CO2E GHGabateB" access="output" isee:autocreated="true">
				<eqn>IF TIME &gt;= 2100 THEN ECO2eGHGB2100
ELSE ECO2eGHGB2020 + (ECO2eGHGB2100 - ECO2eGHGB2020) / (2100 - 2020) * (TIME - 2020)</eqn>
			</aux>
			<aux name="ECO2eGHGB2020">
				<eqn>9.96</eqn>
			</aux>
			<aux name="ECO2eGHGB2100">
				<eqn>15.5</eqn>
			</aux>
			<aux name="foss lim">
				<eqn>6000</eqn>
			</aux>
			<aux name="optimal longrun savings rate">
				<eqn>(&quot;Depreciation_rate_of_capital_(dK)&quot;+ .004)/(&quot;Depreciation_rate_of_capital_(dK)&quot; + .004*&quot;elasticity_marginal_utility_(η)&quot; + &quot;risk-adjusted_pure_time_preference_(ρa)&quot;)*&quot;capital_elasticity_(γ)&quot;</eqn>
			</aux>
			<aux name="cprice base">
				<eqn>cprice1 * (1 + gcprice)</eqn>
			</aux>
			<aux name="cprice1">
				<eqn>6</eqn>
			</aux>
			<aux name="gcprice">
				<eqn>0.025</eqn>
			</aux>
			<aux name="miu1">
				<eqn>0.05</eqn>
			</aux>
			<aux name="limmiu2070">
				<eqn>1</eqn>
			</aux>
			<aux name="limmiu2120">
				<eqn>1.05</eqn>
			</aux>
			<aux name="limmiu2200">
				<eqn>1.1</eqn>
			</aux>
			<aux name="limmiu2300">
				<eqn>1</eqn>
			</aux>
			<aux name="delmiumax">
				<eqn>0.12/5</eqn>
			</aux>
			<aux name="miuup">
				<eqn>IF TIME &lt; 2070 THEN limmiu2070 ELSE IF TIME &gt;=2070 AND TIME &lt; 2120 THEN limmiu2120 ELSE IF TIME &gt;= 2120 AND TIME &lt; 2200 THEN limmiu2200 ELSE limmiu2300</eqn>
			</aux>
			<stock name="Non-CO2 GHG forcing (FGHG)" access="output" isee:autocreated="true">
				<eqn>0.518</eqn>
				<inflow>Flow_7</inflow>
				<units>W/m^2</units>
			</stock>
			<aux name="forcing coefficient 1 (Fc1)">
				<eqn>0.00955</eqn>
				<units>unitless</units>
			</aux>
			<aux name="forcing coefficient 2 (Fc2)">
				<eqn>0.861</eqn>
				<units>unitless</units>
			</aux>
			<flow name="Flow 7">
				<eqn>(&quot;forcing_coefficient_1_(Fc1)&quot; / 5) * CO2E_GHGabateB * (1 - Emissions_control_rate)
  - (-LN(&quot;forcing_coefficient_2_(Fc2)&quot;) /5) * &quot;Non-CO2_GHG_forcing_(FGHG)&quot;</eqn>
				<units>W/m^2/Year</units>
			</flow>
			<group name="Non-CO2 GHG forcing" run="false">
				<entity name='"forcing_coefficient_1_(Fc1)"'/>
				<entity name='"forcing_coefficient_2_(Fc2)"'/>
				<entity name='"Non-CO2_GHG_forcing_(FGHG)"'/>
				<entity name="Flow_7"/>
			</group>
			<aux name="ECO2E">
				<eqn>(CO2E_GHGabateB*(1-Emissions_control_rate))+(exogenous_sigma*&quot;gross_output_(Ygross)&quot;+&quot;land_emissions_(Eland)&quot;)*(1-Emissions_control_rate)</eqn>
			</aux>
			<aux name="cprice">
				<eqn>pback* Emissions_control_rate^(&quot;cost_function_exponent_(θ2)&quot;-1)</eqn>
			</aux>
			<aux name="STP without precautionary factor">
				<eqn>1 / (1 + &quot;risk-adjusted_pure_time_preference_(ρa)&quot;)^((TIME - STARTTIME)/5)</eqn>
			</aux>
			<aux name="Emissions control rate 1" access="output" isee:autocreated="true">
				<eqn>IF TIME = STARTTIME THEN miu0 
ELSE IF (target_miu - PREVIOUS(SELF, miu0 )) &gt; delmiumax THEN PREVIOUS(SELF,  miu0) + delmiumax
ELSE IF (target_miu - PREVIOUS(SELF,  miu0)) &lt; -delmiumax THEN PREVIOUS(SELF,  miu0) - delmiumax

ELSE target_miu</eqn>
			</aux>
			<aux name="optimal miu">
				<doc>fraction of uncontrolled industrial and energy emissions mitigated

in DICE, this is one of the choice variables in the optimization</doc>
				<dimensions>
					<dim name="TimePeriod"/>
				</dimensions>
				<eqn>1.1</eqn>
				<units>fraction</units>
			</aux>
			<aux name="miu0">
				<eqn>0.05</eqn>
			</aux>
			<aux name="target miu">
				<eqn>IF optimal_miu[TIME-STARTTIME] &lt;= miuup THEN optimal_miu[TIME-STARTTIME] ELSE miuup</eqn>
			</aux>
			<aux name="optimal s">
				<doc>fraction of uncontrolled industrial and energy emissions mitigated

in DICE, this is one of the choice variables in the optimization</doc>
				<dimensions>
					<dim name="TimePeriod"/>
				</dimensions>
				<eqn>0.2</eqn>
				<units>fraction</units>
			</aux>
			<aux name="sterm">
				<eqn>0.28</eqn>
			</aux>
			<aux name="op s">
				<eqn>IF TIME = STARTTIME THEN 0.2
ELSE 
IF (TIME-STARTTIME)/5 &gt;= 37 THEN sterm ELSE
optimal_s[INT((TIME-STARTTIME)/5)+1]</eqn>
			</aux>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
				<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
