				</alias>
			</view>
		</views>
	</model>
	<model name="Economy">
		<variables>
			<stock name="Population (L)">
				<eqn>&quot;initial_Population_(Linit)&quot;</eqn>
				<inflow>Population_growth</inflow>
				<non_negative/>
				<units>million people</units>
			</stock>
			<stock name="TFP (AL)">
				<eqn>&quot;initial_TFP_(ALinit)&quot;</eqn>
				<inflow>Change_in_TFP</inflow>
				<non_negative/>
				<units>unitless</units>
			</stock>
			<stock name="Capital (K)">
				<eqn>295</eqn>
				<inflow>Change_in_capital</inflow>
				<non_negative/>
				<units>trillion 2019 USD</units>
			</stock>
			<aux name="Investment (I)">
				<eqn>&quot;savings_rate_(s)&quot;*&quot;Output_(Y)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="Depreciation rate of capital (δK)">
				<eqn>0.1</eqn>
				<units>/year</units>
			</aux>
			<aux name="asymtotic population">
				<eqn>10825</eqn>
				<units>million people</units>
			</aux>
			<aux name="population growth adjustment">
				<eqn>0.029</eqn>
				<units>million people/Year</units>
			</aux>
			<flow name="Population growth">
				<eqn>&quot;Population_(L)&quot;*LN(asymtotic_population/&quot;Population_(L)&quot;)*population_growth_adjustment</eqn>
				<non_negative/>
				<units>million people/Year</units>
			</flow>
			<aux name="TFP growth rate (gA, t)">
				<eqn>-LN(1 - 0.066 * EXP(-0.0015 * (TIME-2020))) / 5</eqn>
				<units>unitless</units>
			</aux>
			<aux name="initial TFP growth rate (gA,0)">
				<eqn>0.013656</eqn>
				<units>unitless</units>
			</aux>
			<flow name="Change in TFP">
				<eqn>&quot;TFP_growth_rate_(gA,_t)&quot;*&quot;TFP_(AL)&quot;</eqn>
				<non_negative/>
				<units>Per Year</units>
			</flow>
			<aux name="decline rate of TFP growth (δA)">
				<eqn>0.0003</eqn>
			</aux>
			<aux name="carbon intensity\ndecline rate (gσ,t)">
				<eqn>MIN(&quot;initial_carbon_intensity_decline_rate_(gσ,1)&quot; * (&quot;decline_rate_of_carbon_intensity_decline_rate_(δgσ)&quot; ^ ((TIME-2020)/5)), &quot;carbon_intensity_decline_asymtote_(gσ,asym)&quot;)</eqn>
			</aux>
			<aux name="initial carbon\nintensity decline rate (gσ,1)">
				<eqn>-0.015</eqn>
				<units>/year</units>
			</aux>
			<aux name="decline rate of carbon\nintensity decline rate (δgσ)">
				<eqn>0.96</eqn>
				<units>unitless</units>
			</aux>
			<aux name="carbon intensity\ndecline asymtote (gσ,asym)">
				<eqn>-0.005</eqn>
				<units>/year</units>
			</aux>
			<aux name="2020 industrial emissions">
				<eqn>37.56</eqn>
				<units>GtCO2/year</units>
			</aux>
			<aux name="2020 world output">
				<eqn>135.7</eqn>
				<units>trillion 2019 USD</units>
			</aux>
			<aux name="2020 emissions control rate">
				<eqn>0.05</eqn>
				<units>unitless</units>
			</aux>
			<aux name="initial carbon intensity">
				<eqn>&quot;2020_industrial_emissions&quot;/(&quot;2020_world_output&quot;*(1-&quot;2020_emissions_control_rate&quot;))</eqn>
				<units>kgCO2/USD</units>
			</aux>
			<flow name="Change in capital">
				<eqn>&quot;Investment_(I)&quot; - 0.081902 * &quot;Capital_(K)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</flow>
			<aux name="savings rate (s)">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2020" max="2419.99999999998"/>
					<yscale min="0" max="100"/>
					<ypts>0.256368777,0.253733125,0.251146506,0.249568137,0.248421591,0.247606134,0.247041,0.246782461,0.246768273,0.246980392,0.247404323,0.248028024,0.248840588,0.249830035,0.250979223,0.252257865,0.253606509,0.255146991,0.256739447,0.258267977,0.259497772,0.259993132,0.261562706,0.262945302,0.264238068,0.265493949,0.266739516,0.267986183,0.269236956,0.270497126,0.27176082,0.273018102,0.274251325,0.275427992,0.276487073,0.277313053,0.27768706,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28,0.28</ypts>
				</gf>
				<units>fraction</units>
			</aux>
			<aux name="gross output (Ygross)">
				<eqn>&quot;TFP_(AL)&quot;*(&quot;Population_(L)&quot;/1000)^(1-&quot;capital_elasticity_(γ)&quot;)*&quot;Capital_(K)&quot;^&quot;capital_elasticity_(γ)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="damages as fraction\nof gross output (Dfrac)">
				<eqn>a1*&quot;Atmospheric_temperature_anomaly_(TATM)&quot;+a2*&quot;Atmospheric_temperature_anomaly_(TATM)&quot;^a3</eqn>
			</aux>
			<aux name="capital elasticity (γ)">
				<eqn>0.3</eqn>
				<units>unitless</units>
			</aux>
			<aux name="a1">
				<eqn>0</eqn>
				<units>/°C</units>
			</aux>
			<aux name="a2">
				<eqn>0.003467</eqn>
				<units>unitless</units>
			</aux>
			<aux name="a3">
				<eqn>2</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Atmospheric temperature anomaly (TATM)" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>°C from 1765</units>
			</aux>
			<aux name="Economic damages (D)">
				<eqn>&quot;damages_as_fraction_of_gross_output_(Dfrac)&quot;*&quot;gross_output_(Ygross)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<group name="Carbon Intensity" run="false">
				<entity name='"2020_emissions_control_rate"'/>
				<entity name='"2020_industrial_emissions"'/>
				<entity name='"2020_world_output"'/>
				<entity name='"carbon_intensity_decline_asymtote_(gσ,asym)"'/>
				<entity name='"carbon_intensity_decline_rate_(gσ,t)"'/>
				<entity name='"decline_rate_of_carbon_intensity_decline_rate_(δgσ)"'/>
				<entity name='"initial_carbon_intensity_decline_rate_(gσ,1)"'/>
				<entity name="carbon_intensity_1"/>
				<entity name="initial_carbon_intensity"/>
			</group>
			<group name="TFP" run="false">
				<entity name='"decline_rate_of_TFP_growth_(δA)"'/>
				<entity name='"initial_TFP_growth_rate_(gA,0)"'/>
				<entity name='"TFP_(AL)"'/>
				<entity name='"TFP_growth_rate_(gA,_t)"'/>
				<entity name="Change_in_TFP"/>
			</group>
			<group name="Population" run="false">
				<entity name='"Population_(L)"'/>
				<entity name="asymtotic_population"/>
				<entity name="Population_growth"/>
				<entity name="population_growth_adjustment"/>
			</group>
			<group name="Capital" run="false">
				<entity name='"Capital_(K)"'/>
				<entity name='"consumption_(C)"'/>
				<entity name='"Depreciation_rate_of_capital_(δK)"'/>
				<entity name='"Investment_(I)"'/>
				<entity name='"Output_(Y)"'/>
				<entity name='"per_capital_consumption_(c)"'/>
				<entity name='"savings_rate_(s)"'/>
				<entity name="Change_in_capital"/>
			</group>
			<group name="Damages to Econ" run="false">
				<entity name='"Atmospheric_temperature_anomaly_(TATM)"'/>
				<entity name='"damages_as_fraction_of_gross_output_(Dfrac)"'/>
				<entity name='"Economic_damages_(D)"'/>
				<entity name='"net_output_(Ynet)"'/>
				<entity name="a1"/>
				<entity name="a2"/>
				<entity name="a3"/>
			</group>
			<aux name="net output (Ynet)">
				<eqn>&quot;gross_output_(Ygross)&quot;*(1-&quot;damages_as_fraction_of_gross_output_(Dfrac)&quot;)</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="cost of emissions abatement (Cabate)">
				<eqn>&quot;gross_output_(Ygross)&quot;*&quot;total_abatement_cost_factor_(θ1)&quot;*Emissions_control_rate^&quot;cost_function_exponent_(θ2)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="total abatement\ncost factor (θ1)">
				<eqn>(&quot;total_emissions_intensity_(σtot)&quot;*pback)/(&quot;cost_function_exponent_(θ2)&quot;*1000)</eqn>
			</aux>
			<aux name="cost function exponent (θ2)">
				<eqn>2.6</eqn>
				<units>unitless</units>
			</aux>
			<aux name="pback">
				<eqn>IF TIME&lt;=2050 THEN pback2020 ELSE pback2050</eqn>
				<units>2019 USD/tCO2</units>
			</aux>
			<aux name="pback2020">
				<eqn>515 * EXP(-0.01 * (TIME - 2050))</eqn>
				<units>2019 USD/tCO2</units>
			</aux>
			<aux name="marginal cost of abatement (MCabate)">
				<eqn>pback*Emissions_control_rate^(&quot;cost_function_exponent_(θ2)&quot;-1)</eqn>
				<units>2019 USD/tCO2</units>
			</aux>
			<aux name="initial Population (Linit)">
				<eqn>7752.9</eqn>
				<units>million people</units>
			</aux>
			<aux name="initial output (Ygross0)">
				<eqn>135.7</eqn>
				<units>trillion 2019 USD</units>
			</aux>
			<aux name="initial TFP (ALinit)">
				<eqn>5.84</eqn>
				<units>unitless</units>
			</aux>
			<aux name="initial industrial emissions (Eind0)">
				<eqn>37.56</eqn>
				<units>GtCO2/year</units>
			</aux>
			<aux name="initial control rate (µ0)">
				<eqn>0.05</eqn>
			</aux>
			<aux name="elasticity marginal utility (η)">
				<eqn>0.95</eqn>
				<units>unitless</units>
			</aux>
			<aux name="pure time preference (ρ)">
				<eqn>0.001</eqn>
				<units>/year</units>
			</aux>
			<aux name="climate beta (βclim)">
				<eqn>0.5</eqn>
				<units>unitless</units>
			</aux>
			<aux name="capital risk premium (π)">
				<eqn>0.05</eqn>
				<units>/year</units>
			</aux>
			<aux name="std dev consumption\ngrowth (Vc)">
				<eqn>MIN(0.0005*(TIME-2020), 0.235)</eqn>
				<units>/year</units>
			</aux>
			<aux name="utility scaling factor 1 (κ1)">
				<eqn>0.00891061</eqn>
				<units>unitless</units>
			</aux>
			<aux name="utility scaling factor 2 (κ2)">
				<eqn>-6275.91</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Emissions control rate" access="output" isee:autocreated="true">
				<eqn>miu</eqn>
			</aux>
			<flow name="emissions accumulating">
				<eqn>&quot;total_CO2_emissions_(ECo2)&quot;/3.666</eqn>
				<units>GtC/Year</units>
			</flow>
			<stock name="cumulative carbon\nemissions (Ctot)" access="output" isee:autocreated="true">
				<eqn>633.5</eqn>
				<inflow>emissions_accumulating</inflow>
				<units>GtC</units>
			</stock>
			<aux name="industrial emissions">
				<eqn>(carbon_intensity_1*&quot;gross_output_(Ygross)&quot;
*(1-Emissions_control_rate))</eqn>
			</aux>
			<aux name="land emissions (Eland)">
				<eqn>&quot;initial_land_emissions_(Eland0)&quot; * EXP(-&quot;land_emissions_decline_rate_(λland)&quot; * (TIME-2020))</eqn>
				<units>GtCO2/year</units>
			</aux>
			<aux name="total CO2 emissions (ECo2)" access="output" isee:autocreated="true">
				<eqn>&quot;land_emissions_(Eland)&quot;+industrial_emissions</eqn>
				<units>GtCO2/year</units>
			</aux>
			<aux name="land emissions decline\nrate (λland)">
				<eqn>0.02107</eqn>
				<units>/year</units>
			</aux>
			<group name="Emissions" run="false">
				<entity name='"cumulative_carbon_emissions_(Ctot)"'/>
				<entity name='"initial_land_emissions_(Eland0)"'/>
				<entity name='"land_emissions_(Eland)"'/>
				<entity name='"land_emissions_decline_rate_(λland)"'/>
				<entity name='"total_CO2_emissions_(ECo2)"'/>
				<entity name="emissions_accumulating"/>
				<entity name="Emissions_control_rate"/>
				<entity name="industrial_emissions"/>
			</group>
			<aux name="initial land emissions (Eland0)">
				<eqn>5.9</eqn>
				<units>GtCO2/year</units>
			</aux>
			<aux name="emissions ratio 2020 (remiss0)">
				<eqn>1.4</eqn>
				<units>unitless</units>
			</aux>
			<aux name="emissions ratio 2100 (remiss80)">
				<eqn>1.21</eqn>
				<units>unitless</units>
			</aux>
			<aux name="total emissions intensity (σtot)">
				<eqn>carbon_intensity_1*&quot;emissions_ratio_(remiss)&quot;</eqn>
			</aux>
			<aux name="emissions ratio (remiss)">
				<eqn>IF TIME &lt;= 2100 THEN 
                &quot;emissions_ratio_2020_(remiss0)&quot; + (&quot;emissions_ratio_2100_(remiss80)&quot; - &quot;emissions_ratio_2020_(remiss0)&quot;)/80 * (TIME -2020)
             ELSE 
       &quot;emissions_ratio_2100_(remiss80)&quot;</eqn>
			</aux>
			<aux name="pback2050">
				<eqn>515 * EXP(-0.001 * (TIME - 2050))</eqn>
			</aux>
			<aux name="consumption (C)">
				<eqn>&quot;Output_(Y)&quot;-&quot;Investment_(I)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="Output (Y)">
				<eqn>&quot;net_output_(Ynet)&quot;-&quot;cost_of_emissions_abatement_(Cabate)&quot;</eqn>
				<units>trillion 2019 USD/Year</units>
			</aux>
			<aux name="per capital consumption (c)">
				<eqn>1000*&quot;consumption_(C)&quot;/&quot;Population_(L)&quot;</eqn>
				<units>thousand 2019 USD/ capita/ year</units>
			</aux>
			<aux name="instantaneous utility (u(c))">
				<eqn>((&quot;per_capital_consumption_(c)&quot;^(1-&quot;elasticity_marginal_utility_(η)&quot;)-1)/(1-&quot;elasticity_marginal_utility_(η)&quot;))-1</eqn>
				<units>unitless</units>
			</aux>
			<aux name="period utility (U)">
				<eqn>&quot;instantaneous_utility_(u(c))&quot;*&quot;Population_(L)&quot;*&quot;Discount_factor_(R)&quot;</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Discount factor (R)">
				<eqn>&quot;base_discount_factor_(R1)&quot;*(2.72^((TIME-2020)*&quot;precautionary_adjustment_(rpre)&quot;))</eqn>
			</aux>
			<aux name="total welfare (W)">
				<eqn>&quot;utility_scaling_factor_1_(κ1)&quot; * &quot;Accumulated_Utility_(Uacc)&quot; + &quot;utility_scaling_factor_2_(κ2)&quot;</eqn>
			</aux>
			<stock name="Accumulated Utility (Uacc)">
				<eqn>0</eqn>
				<inflow>accumulation_of_utility</inflow>
				<units>unitless</units>
			</stock>
			<flow name="accumulation of utility">
				<eqn>-&quot;period_utility_(U)&quot;</eqn>
				<units>Per Year</units>
			</flow>
			<aux name="risk-adjusted pure time\npreference (ρa)">
				<eqn> 0.02628</eqn>
				<units>/year</units>
			</aux>
			<aux name="base discount factor (R1)">
				<eqn>1/(1.02628^(TIME-2020))</eqn>
				<units>unitless</units>
			</aux>
			<aux name="precautionary adjustment (rpre)">
				<eqn>-0.5*&quot;std_dev_consumption_growth_(Vc)&quot;* 0.9025</eqn>
			</aux>
			<aux name="Long run discount factor (RFlong)">
				<eqn>1e6*(&quot;per_capital_consumption_(c)&quot;/&quot;initial_per_capiita_consumption_(c0)&quot;)^-0.95*&quot;Discount_factor_(R)&quot;</eqn>
				<units>unitless</units>
			</aux>
			<aux name="long run interest rate (rlong)">
				<eqn>(LN(&quot;Long_run_discount_factor_(RFlong)&quot;/1e6))/(TIME-2015)</eqn>
				<units>/year</units>
			</aux>
			<aux name="short run interest rate (rshort)">
				<eqn>-LN(&quot;Long_run_discount_factor_(RFlong)&quot; / DELAY(&quot;Long_run_discount_factor_(RFlong)&quot;, DT)) / DT</eqn>
				<units>/year</units>
			</aux>
			<aux name="initial per capiita\nconsumption (c0)">
				<eqn>12.46</eqn>
				<units>thousand 2019 USD/ capita/ year</units>
			</aux>
			<group name="Utility" run="false">
				<entity name='"Accumulated_Utility_(Uacc)"'/>
				<entity name='"base_discount_factor_(R1)"'/>
				<entity name='"climate_beta_(βclim)"'/>
				<entity name='"Discount_factor_(R)"'/>
				<entity name='"elasticity_marginal_utility_(η)"'/>
				<entity name='"initial_per_capiita_consumption_(c0)"'/>
				<entity name='"instantaneous_utility_(u(c))"'/>
				<entity name='"Long_run_discount_factor_(RFlong)"'/>
				<entity name='"long_run_interest_rate_(rlong)"'/>
				<entity name='"period_utility_(U)"'/>
				<entity name='"precautionary_adjustment_(rpre)"'/>
				<entity name='"risk-adjusted_pure_time_preference_(ρa)"'/>
				<entity name='"short_run_interest_rate_(rshort)"'/>
				<entity name='"std_dev_consumption_growth_(Vc)"'/>
				<entity name="accumulation_of_utility"/>
			</group>
			<group name="Abatement" run="false">
				<entity name='"cost_function_exponent_(θ2)"'/>
				<entity name='"cost_of_emissions_abatement_(Cabate)"'/>
				<entity name='"emissions_ratio_(remiss)"'/>
				<entity name='"emissions_ratio_2020_(remiss0)"'/>
				<entity name='"emissions_ratio_2100_(remiss80)"'/>
				<entity name='"marginal_cost_of_abatement_(MCabate)"'/>
				<entity name='"total_abatement_cost_factor_(θ1)"'/>
				<entity name='"total_emissions_intensity_(σtot)"'/>
				<entity name="pback"/>
				<entity name="pback2020"/>
				<entity name="pback2050"/>
			</group>
			<group name="Initial conditions" run="false">
				<entity name='"initial_control_rate_(µ0)"'/>
				<entity name='"initial_industrial_emissions_(Eind0)"'/>
				<entity name='"initial_output_(Ygross0)"'/>
				<entity name='"initial_Population_(Linit)"'/>
				<entity name='"initial_TFP_(ALinit)"'/>
			</group>
			<group name="Wellfare" run="false">
				<entity name='"total_welfare_(W)"'/>
				<entity name='"utility_scaling_factor_1_(κ1)"'/>
				<entity name='"utility_scaling_factor_2_(κ2)"'/>
			</group>
			<aux name="carbon intensity 1">
				<eqn>IF INT((TIME-2020)/5) &lt;= 27 THEN
 initial_carbon_intensity * EXP(5 * &quot;initial_carbon_intensity_decline_rate_(gσ,1)&quot; * (1 - &quot;decline_rate_of_carbon_intensity_decline_rate_(δgσ)&quot;^INT((TIME-2020)/5)) / (1 - &quot;decline_rate_of_carbon_intensity_decline_rate_(δgσ)&quot;))
ELSE
  0.08328823 * EXP(-0.005 * (INT((TIME-2020)/5) - 27) * 5)</eqn>
			</aux>
			<aux name="optimal miu">
				<doc>fraction of uncontrolled industrial and energy emissions mitigated

in DICE, this is one of the choice variables in the optimization</doc>
				<dimensions>
					<dim name="TimePeriod"/>
				</dimensions>
				<eqn>0.2</eqn>
				<units>fraction</units>
			</aux>
			<aux name="isthistimeperiod">
				<dimensions>
					<dim name="TimePeriod"/>
				</dimensions>
				<eqn>( IF INT(TIME-STARTTIME) = TimePeriod-1 THEN 1 ELSE 0 )</eqn>
			</aux>
			<aux name="miu">
				<doc>SUM(optimal_miu[*]*isthistimeperiod[*])</doc>
				<eqn>IF TIME = STARTTIME THEN miu0 ELSE SUM(optimal_miu[*]*isthistimeperiod[*])</eqn>
			</aux>
			<aux name="miu0">
				<eqn>0.05</eqn>
			</aux>
		</variables>
