				<alias color="blue" background="white" font_style="italic" uid="55" x="1409.07" y="115.492" width="18" height="18">
					<shape type="circle" radius="18"/>
					<of>&quot;carbon_accumulated_in_ocean_and_land_sinks_(Cacc)&quot;</of>
				</alias>
				<alias color="blue" background="white" font_style="italic" uid="56" x="1404.23" y="45.8642" width="18" height="18">
					<shape type="circle" radius="18"/>
