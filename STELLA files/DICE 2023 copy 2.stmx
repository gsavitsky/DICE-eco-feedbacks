				</connector>
				<connector uid="119" angle="34.0085">
					<from>&quot;Decay_time_constant_for_reservoir_2_(τ2)&quot;</from>
					<to>EXP_R2</to>
				</connector>
				<connector uid="120" angle="193.198">
					<from>&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;</from>
					<to>EXP_R2</to>
				</connector>
				<connector uid="121" angle="29.14">
					<from>&quot;Decay_time_constant_for_reservoir_3_(τ3)&quot;</from>
					<to>EXP_R3</to>
