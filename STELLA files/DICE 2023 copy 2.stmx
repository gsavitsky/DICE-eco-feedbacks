					<to>Flow_4</to>
				</connector>
				<aux x="1381.56" y="483.436" name="EXP R0"/>
				<aux x="1661" y="474.189" name="EXP R1"/>
				<aux x="1578.08" y="490.672" name="EXP R2"/>
				<aux x="1939.55" y="508.672" name="EXP R3"/>
				<connector uid="115" angle="85.5116">
					<from>&quot;Decay_time_constant_for_reservoir_0_(τ0)&quot;</from>
					<to>EXP_R0</to>
				</connector>
				<connector uid="116" angle="156.344">
					<from>&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;</from>
					<to>EXP_R0</to>
				</connector>
				<connector uid="117" angle="152.455">
					<from>&quot;Decay_time_constant_for_reservoir_1_(τ1)&quot;</from>
