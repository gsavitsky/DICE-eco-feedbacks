	<model name="Climate">
		<variables>
			<stock name="Deep ocean temperature anomaly (T1)">
				<eqn>0.1477</eqn>
				<inflow>Flow_5</inflow>
				<units>°C from 1765</units>
			</stock>
			<stock name="Carbon Reservoir 0 (R0)">
				<eqn>150.093</eqn>
				<inflow>Flow_1</inflow>
				<units>GtC</units>
			</stock>
			<stock name="Carbon Reservoir 1 (R1)">
				<eqn>102.698</eqn>
				<inflow>Flow_2</inflow>
				<units>GtC</units>
			</stock>
			<stock name="Carbon Reservoir 2 (R2)">
				<eqn>39.534</eqn>
				<inflow>Flow_3</inflow>
				<units>GtC</units>
			</stock>
			<stock name="Carbon Reservoir 3 (R3)">
				<eqn>6.1865</eqn>
				<inflow>Flow_4</inflow>
				<units>GtC</units>
			</stock>
			<stock name="Upper ocean temperature anomaly (T2)">
				<eqn>1.099454</eqn>
				<inflow>Flow_6</inflow>
				<units>°C from 1765</units>
			</stock>
			<stock name="Non-CO2 GHG forcing (FGHG)">
				<eqn>0.518</eqn>
				<inflow>Flow_7</inflow>
				<units>W/m^2</units>
			</stock>
			<aux name="Emission share into\nreservoir 0 (ϵ0)">
				<eqn>0.2173</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Emission share into\nreservoir 1 (ϵ1)">
				<eqn>0.224</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Emission share into\nreservoir 2 (ϵ2)">
				<eqn>0.2824</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Emission share into\nreservoir 3 (ϵ3)">
				<eqn>0.2763</eqn>
				<units>unitless</units>
			</aux>
			<aux name="Decay time constant for reservoir 0 (τ0)">
				<eqn>1000000</eqn>
				<units>Years</units>
			</aux>
			<aux name="Decay time constant\nfor reservoir 1 (τ1)">
				<eqn>394.4</eqn>
				<units>Years</units>
			</aux>
			<aux name="Decay time constant\nfor reservoir 2 (τ2)">
				<eqn>36.53</eqn>
				<units>Years</units>
			</aux>
			<aux name="Decay time constant\nfor reservoir 3 (τ3)">
				<eqn>4.304</eqn>
				<units>Years</units>
			</aux>
			<aux name="total CO2 emissions (ECo2)" access="input">
				<eqn>{Enter equation for use when not hooked up to other models}</eqn>
				<units>GtCO2/year</units>
			</aux>
			<flow name="Flow 1">
				<eqn>&quot;Carbon_Reservoir_0_(R0)&quot;*(EXP_R0-1) + (&quot;Emission_share_into_reservoir_0_(ϵ0)&quot;*&quot;total_CO2_emissions_(ECo2)&quot;/3.666)*&quot;Decay_time_constant_for_reservoir_0_(τ0)&quot;*&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;*(1-EXP_R0)</eqn>
				<units>GtC/Year</units>
			</flow>
			<flow name="Flow 2">
				<eqn>&quot;Carbon_Reservoir_1_(R1)&quot;*(EXP_R1-1) + (&quot;Emission_share_into_reservoir_1_(ϵ1)&quot;*&quot;total_CO2_emissions_(ECo2)&quot;/3.666)*&quot;Decay_time_constant_for_reservoir_1_(τ1)&quot;*&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;*(1-EXP_R1)</eqn>
				<units>GtC/Year</units>
			</flow>
			<flow name="Flow 3">
				<eqn>&quot;Carbon_Reservoir_2_(R2)&quot;*(EXP_R2-1) + (&quot;Emission_share_into_reservoir_2_(ϵ2)&quot;*&quot;total_CO2_emissions_(ECo2)&quot;/3.666)*&quot;Decay_time_constant_for_reservoir_2_(τ2)&quot;*&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;*(1-EXP_R2)</eqn>
				<units>GtC/Year</units>
			</flow>
			<flow name="Flow 4">
				<eqn>&quot;Carbon_Reservoir_3_(R3)&quot;*(EXP_R3-1) + (&quot;Emission_share_into_reservoir_3_(ϵ3)&quot;*&quot;total_CO2_emissions_(ECo2)&quot;/3.666)*&quot;Decay_time_constant_for_reservoir_3_(τ3)&quot;*&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;*(1-EXP_R3)</eqn>
				<units>GtC/Year</units>
			</flow>
			<aux name="thermal equilibration\nparameter for box 1 (Teq1)">
				<eqn>0.324</eqn>
				<units>m^2/kW</units>
			</aux>
			<aux name="thermal equilibration\nparameter for box 2 (Teq2)">
				<eqn>0.44</eqn>
				<units>m^2/kW</units>
			</aux>
			<flow name="Flow 5">
				<eqn>(1/&quot;thermal_response_time_for_box_1_(d1)&quot;)*(&quot;thermal_equilibration_parameter_for_box_1_(Teq1)&quot;*&quot;radiative_forcing_(F)&quot;-&quot;Deep_ocean_temperature_anomaly_(T1)&quot;)</eqn>
				<units>°C from 1765/Year</units>
			</flow>
			<flow name="Flow 6">
				<eqn>(1/&quot;thermal_response_time_for_box_2_(d2)&quot;)*(&quot;thermal_equilibration_parameter_for_box_2_(Teq2)&quot;*&quot;radiative_forcing_(F)&quot;-&quot;Upper_ocean_temperature_anomaly_(T2)&quot;)</eqn>
				<units>°C from 1765/Year</units>
			</flow>
			<aux name="radiative forcing (F)">
				<eqn>&quot;Non-CO2_GHG_forcing_(FGHG)&quot;+&quot;Miscellaneous_forcing_(Fmisc)&quot;+&quot;Co2_forcing_(FCO2)&quot;</eqn>
				<units>W/m^2</units>
			</aux>
			<aux name="thermal response time for box 1 (d1)">
				<eqn>236</eqn>
				<units>Years</units>
			</aux>
			<aux name="thermal response time\nfor box 2 (d2)">
				<eqn>4.07</eqn>
				<units>Years</units>
			</aux>
			<aux name="forcing coefficient 1 (Fc1)">
				<eqn>0.002056</eqn>
				<units>unitless</units>
			</aux>
			<aux name="forcing coefficient 2 (Fc2)">
				<eqn>0.97033</eqn>
				<units>unitless</units>
			</aux>
			<aux name="non-CO2 GHG\nemissions 2020 (EGHG0)">
				<eqn>9.96</eqn>
				<units>GtCO2/year</units>
			</aux>
			<flow name="Flow 7">
				<eqn>&quot;Non-CO2_GHG_forcing_(FGHG)&quot;*(EXP_FGHG-1) + 0.06871*&quot;non-CO2_GHG_emissions_(EGHGbase)&quot;*(1-&quot;emissions_control_rate_(μ)&quot;)*(1-EXP_FGHG)</eqn>
				<units>W/m^2/Year</units>
			</flow>
			<aux name="pre-industrial equilibrium atosmpheric carbon (Meq)">
				<eqn>588</eqn>
				<units>GtC</units>
			</aux>
			<aux name="carbon accumulated in ocean and land sinks (Cacc)">
				<eqn>&quot;cumulative_carbon_emissions_(Ctot)&quot;-(&quot;Atmospheric_carbon_concentration_(MAT)&quot;-&quot;pre-industrial_equilibrium_atosmpheric_carbon_(Meq)&quot;)</eqn>
			</aux>
			<aux name="Atmospheric carbon concentration (MAT)">
				<eqn>&quot;pre-industrial_equilibrium_atosmpheric_carbon_(Meq)&quot;+&quot;Carbon_Reservoir_3_(R3)&quot;+&quot;Carbon_Reservoir_2_(R2)&quot;+&quot;Carbon_Reservoir_1_(R1)&quot;+&quot;Carbon_Reservoir_0_(R0)&quot;</eqn>
			</aux>
			<aux name="Atmospheric temperature anomaly (TATM)" access="output" isee:autocreated="true">
				<eqn>&quot;Deep_ocean_temperature_anomaly_(T1)&quot;+&quot;Upper_ocean_temperature_anomaly_(T2)&quot;</eqn>
				<units>°C from 1765</units>
			</aux>
			<aux name="Miscellaneous forcing 2020 (Fmisc0)">
				<eqn>-0.054</eqn>
				<units>W/m^2</units>
			</aux>
			<aux name="IRF 100 target">
				<eqn>IRF0+&quot;Sensitivity_of_IRF_to_cumulative_carbon_uptake_(irC)&quot;*&quot;carbon_accumulated_in_ocean_and_land_sinks_(Cacc)&quot;+&quot;Sensitivity_of_IRF_to_temperature_(irT)&quot;*&quot;Atmospheric_temperature_anomaly_(TATM)&quot;</eqn>
			</aux>
			<aux name="IRF0">
				<eqn>32.4</eqn>
				<units>Years</units>
			</aux>
			<aux name="Sensitivity of IRF to\ncumulative carbon uptake (irC)">
				<eqn>0.019</eqn>
				<units>Year/GtC</units>
			</aux>
			<aux name="Sensitivity of IRF\nto temperature (irT)">
				<eqn>4.165</eqn>
				<units>year/°C</units>
			</aux>
			<aux name="IRF100 modeled">
				<eqn>&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot; * (
 &quot;Emission_share_into_reservoir_0_(ϵ0)&quot; * &quot;Decay_time_constant_for_reservoir_0_(τ0)&quot; * (1 - EXP(-100 / (&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot; * &quot;Decay_time_constant_for_reservoir_0_(τ0)&quot;))) +
&quot;Emission_share_into_reservoir_1_(ϵ1)&quot; * &quot;Decay_time_constant_for_reservoir_1_(τ1)&quot; * (1 - EXP(-100 / (&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot; * &quot;Decay_time_constant_for_reservoir_1_(τ1)&quot;))) +
&quot;Emission_share_into_reservoir_2_(ϵ2)&quot; * &quot;Decay_time_constant_for_reservoir_2_(τ2)&quot; * (1 - EXP(-100 / (&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot; * &quot;Decay_time_constant_for_reservoir_2_(τ2)&quot;))) +
&quot;Emission_share_into_reservoir_3_(ϵ3)&quot; * &quot;Decay_time_constant_for_reservoir_3_(τ3)&quot; * (1 - EXP(-100 / (&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot; * &quot;Decay_time_constant_for_reservoir_3_(τ3)&quot;))))</eqn>
			</aux>
			<aux name="Miscellaneous forcing\n2100 (Fmisc80)">
				<eqn>0.265</eqn>
				<units>W/m^2</units>
			</aux>
			<aux name="non-CO2 GHG\nemissions 2100 (EGHG80)">
				<eqn>15.5</eqn>
				<units>GtCO2/year</units>
			</aux>
			<aux name="emissions control rate (μ)" access="input">
				<eqn>TIME</eqn>
			</aux>
			<aux name="Co2 forcing (FCO2)">
				<eqn>3.93*(LN(&quot;Atmospheric_carbon_concentration_(MAT)&quot;/588))/LN(2)</eqn>
			</aux>
			<aux name="Miscellaneous forcing (Fmisc)">
				<eqn>IF TIME &lt;= 2100 THEN 
                &quot;Miscellaneous_forcing_2020_(Fmisc0)&quot; + (&quot;Miscellaneous_forcing_2100_(Fmisc80)&quot; - &quot;Miscellaneous_forcing_2020_(Fmisc0)&quot;)/80 * (TIME-2020) 
             ELSE 
              &quot;Miscellaneous_forcing_2100_(Fmisc80)&quot;</eqn>
				<units>W/m^2</units>
			</aux>
			<aux name="non-CO2 GHG\nemissions (EGHGbase)">
				<eqn>IF TIME &lt;= 2100 THEN 
                &quot;non-CO2_GHG_emissions_2020_(EGHG0)&quot; + (&quot;non-CO2_GHG_emissions_2100_(EGHG80)&quot; - &quot;non-CO2_GHG_emissions_2020_(EGHG0)&quot;)/80 * (TIME -2020)
             ELSE 
                &quot;non-CO2_GHG_emissions_2100_(EGHG80)&quot;</eqn>
				<units>GtCO2/year</units>
			</aux>
			<stock name="cumulative carbon\nemissions (Ctot)" access="input">
				<eqn>633.5</eqn>
				<non_negative/>
				<units>GtC</units>
			</stock>
			<group name="Carbon cycle scaling" run="false">
				<entity name='"Carbon_cycle_feedback_scaling_factor_(α)"'/>
				<entity name='"Sensitivity_of_IRF_to_cumulative_carbon_uptake_(irC)"'/>
				<entity name='"Sensitivity_of_IRF_to_temperature_(irT)"'/>
				<entity name="IRF0"/>
				<entity name="IRF100_modeled"/>
				<entity name="IRF_100_target"/>
			</group>
			<group name="Non-CO2 GHG forcing" run="false">
				<entity name='"emissions_control_rate_(μ)"'/>
				<entity name='"forcing_coefficient_1_(Fc1)"'/>
				<entity name='"forcing_coefficient_2_(Fc2)"'/>
				<entity name='"non-CO2_GHG_emissions_(EGHGbase)"'/>
				<entity name='"non-CO2_GHG_emissions_2020_(EGHG0)"'/>
				<entity name='"non-CO2_GHG_emissions_2100_(EGHG80)"'/>
				<entity name='"Non-CO2_GHG_forcing_(FGHG)"'/>
				<entity name="EXP_FGHG"/>
				<entity name="Flow_7"/>
			</group>
			<group name="Atmospheric Carbon" run="false">
				<entity name='"Atmospheric_carbon_concentration_(MAT)"'/>
				<entity name='"carbon_accumulated_in_ocean_and_land_sinks_(Cacc)"'/>
				<entity name='"cumulative_carbon_emissions_(Ctot)"'/>
				<entity name='"pre-industrial_equilibrium_atosmpheric_carbon_(Meq)"'/>
			</group>
			<group name="Climate model" run="false">
				<entity name='"Atmospheric_temperature_anomaly_(TATM)"'/>
				<entity name='"Co2_forcing_(FCO2)"'/>
				<entity name='"Deep_ocean_temperature_anomaly_(T1)"'/>
				<entity name='"Miscellaneous_forcing_(Fmisc)"'/>
				<entity name='"Miscellaneous_forcing_2020_(Fmisc0)"'/>
				<entity name='"Miscellaneous_forcing_2100_(Fmisc80)"'/>
				<entity name='"radiative_forcing_(F)"'/>
				<entity name='"thermal_equilibration_parameter_for_box_1_(Teq1)"'/>
				<entity name='"thermal_equilibration_parameter_for_box_2_(Teq2)"'/>
				<entity name='"thermal_response_time_for_box_1_(d1)"'/>
				<entity name='"thermal_response_time_for_box_2_(d2)"'/>
				<entity name='"Upper_ocean_temperature_anomaly_(T2)"'/>
				<entity name="Flow_5"/>
				<entity name="Flow_6"/>
			</group>
			<group name="Ocean + Terrestrial Carbon" run="false">
				<entity name='"Carbon_Reservoir_0_(R0)"'/>
				<entity name='"Carbon_Reservoir_1_(R1)"'/>
				<entity name='"Carbon_Reservoir_2_(R2)"'/>
				<entity name='"Carbon_Reservoir_3_(R3)"'/>
				<entity name='"Decay_time_constant_for_reservoir_0_(τ0)"'/>
				<entity name='"Decay_time_constant_for_reservoir_1_(τ1)"'/>
				<entity name='"Decay_time_constant_for_reservoir_2_(τ2)"'/>
				<entity name='"Decay_time_constant_for_reservoir_3_(τ3)"'/>
				<entity name='"Emission_share_into_reservoir_0_(ϵ0)"'/>
				<entity name='"Emission_share_into_reservoir_1_(ϵ1)"'/>
				<entity name='"Emission_share_into_reservoir_2_(ϵ2)"'/>
				<entity name='"Emission_share_into_reservoir_3_(ϵ3)"'/>
				<entity name='"total_CO2_emissions_(ECo2)"'/>
				<entity name="EXP_R0"/>
				<entity name="EXP_R1"/>
				<entity name="EXP_R2"/>
				<entity name="EXP_R3"/>
				<entity name="Flow_1"/>
				<entity name="Flow_2"/>
				<entity name="Flow_3"/>
				<entity name="Flow_4"/>
			</group>
			<aux name="Carbon cycle feedback scaling factor (α)">
				<eqn>IRF_100_target</eqn>
				<gf type="extrapolate">
					<xscale min="25" max="60.2"/>
					<yscale min="0" max="2"/>
