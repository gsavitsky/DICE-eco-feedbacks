				</connector>
				<aux x="358.574" y="793.449" name="non-CO2 GHG\nemissions (EGHGbase)"/>
				<connector uid="92" angle="112.542">
					<from>&quot;non-CO2_GHG_emissions_(EGHGbase)&quot;</from>
					<to>Flow_7</to>
				</connector>
				<connector uid="93" angle="28.9701">
					<from>&quot;non-CO2_GHG_emissions_2020_(EGHG0)&quot;</from>
					<to>&quot;non-CO2_GHG_emissions_(EGHGbase)&quot;</to>
				</connector>
				<connector uid="94" angle="130.474">
					<from>&quot;non-CO2_GHG_emissions_2100_(EGHG80)&quot;</from>
					<to>&quot;non-CO2_GHG_emissions_(EGHGbase)&quot;</to>
				</connector>
				<stock font_style="italic" font_weight="bold" x="831.555" y="670.706" name="cumulative carbon\nemissions (Ctot)"/>
				<connector uid="95" angle="354.977">
					<from>&quot;cumulative_carbon_emissions_(Ctot)&quot;</from>
					<to>&quot;carbon_accumulated_in_ocean_and_land_sinks_(Cacc)&quot;</to>
				</connector>
				<group locked="true" x="1357.19" y="37.6421" width="521.406" height="377.564" name="Carbon cycle scaling">
					<item uid="55"/>
					<item uid="56"/>
				</group>
				<group locked="true" x="23.4862" y="632.989" width="609.473" height="312.013" name="Non-CO2 GHG forcing"/>
				<group locked="true" x="651.101" y="610.632" width="643.848" height="334.908" name="Atmospheric Carbon"/>
				<group locked="true" x="33.6217" y="44.0668" width="667.476" height="405.235" name="Climate model"/>
				<group locked="true" x="1340.92" y="459.732" width="635.63" height="492.662" name="Ocean + Terrestrial Carbon"/>
				<aux x="1646.77" y="251.65" name="Carbon cycle feedback scaling factor (α)"/>
				<connector uid="108" angle="148.735">
					<from>&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;</from>
					<to>Flow_1</to>
				</connector>
				<connector uid="109" angle="351.535">
					<from>IRF_100_target</from>
					<to>&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;</to>
				</connector>
				<connector uid="110" angle="251.124">
					<from>&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;</from>
					<to>IRF100_modeled</to>
				</connector>
				<connector uid="111" angle="112.928">
					<from>&quot;Decay_time_constant_for_reservoir_3_(τ3)&quot;</from>
