				</gf>
			</aux>
			<aux name="EXP R0">
				<eqn>EXP(-1/(&quot;Decay_time_constant_for_reservoir_0_(τ0)&quot; * &quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;))</eqn>
			</aux>
			<aux name="EXP R1">
				<eqn>EXP(-1/(&quot;Decay_time_constant_for_reservoir_1_(τ1)&quot; *&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;))</eqn>
			</aux>
			<aux name="EXP R2">
				<eqn>EXP(-1/(&quot;Decay_time_constant_for_reservoir_2_(τ2)&quot; *&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;))</eqn>
			</aux>
			<aux name="EXP R3">
				<eqn>EXP(-1/(&quot;Decay_time_constant_for_reservoir_3_(τ3)&quot; *&quot;Carbon_cycle_feedback_scaling_factor_(α)&quot;))</eqn>
			</aux>
			<aux name="EXP FGHG">
				<eqn>EXP(-0.02993)</eqn>
			</aux>
		</variables>
